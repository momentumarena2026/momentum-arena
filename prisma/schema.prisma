// EQUIPMENT RENTAL
// ===========================

model Equipment {
  id                   String            @id @default(cuid())
  name                 String
  sport                Sport?
  // Narrows applicability inside CRICKET. NULL = available for
  // every cricket booking type; BOWLING_MACHINE = only shown in
  // the bowling-machine checkout (kit, bat, L-guard etc).
  category             BookingCategory?
  // Rental price in PAISE for the FULL booking, regardless of
  // duration. Renamed in code as `pricePerBooking` — the column
  // keeps its historical name so existing data and the related
  // EquipmentRental.totalPrice math (which already treats this
  // field as a per-booking flat fee) stay unchanged.
  pricePerHour         Int
  totalUnits           Int               @default(1)
  availableUnits       Int               @default(1)
  isActive             Boolean           @default(true)
  imageUrl             String?
  // Surfaces the item in the customer-facing checkout (web +
  // mobile). Items that exist only as admin-managed bookkeeping
  // — e.g. one-off venue extras — can be hidden by flipping this
  // false without deleting the row.
  isCustomerSelectable Boolean           @default(true)
  // Sort key within the checkout list. Lower = closer to the top.
  // Admin reorders via /admin/equipment.
  displayOrder         Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  rentals              EquipmentRental[]
}

model EquipmentRental {
  id          String    @id @default(cuid())
  bookingId   String
  booking     Booking   @relation(fields: [bookingId], references: [id])
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  quantity    Int       @default(1)
  totalPrice  Int // paise
  createdAt   DateTime  @default(now())

  @@index([bookingId])
  @@index([equipmentId])
}

// ===========================
// RECURRING BOOKINGS
// ===========================

model RecurringConfig {
  id String @id @default(cuid())

  // Weekly discount tiers stored as JSON: [{ weeks: 4, discountPercent: 5 }, { weeks: 8, discountPercent: 10 }, ...]
  // Sorted by weeks ascending
  tiers Json @default("[]")

  // Allowed recurring days (0=Sun … 6=Sat). Empty = all days allowed
  allowedDays Json @default("[0,1,2,3,4,5,6]")

  // Max weeks a customer can book recurring
  maxWeeks Int @default(12)

  // Min weeks to qualify for recurring
  minWeeks Int @default(2)

  // Daily recurring discount tiers: [{ days: 5, discountPercent: 3 }, { days: 10, discountPercent: 7 }, ...]
  dailyTiers Json @default("[]")

  // Max consecutive days allowed for daily recurring
  maxDays Int @default(30)

  // Min days for daily recurring
  minDays Int @default(2)

  // Whether recurring bookings are enabled
  enabled Boolean @default(true)

  updatedAt DateTime @updatedAt
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
}

model RecurringBooking {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  courtConfigId String
  courtConfig   CourtConfig     @relation(fields: [courtConfigId], references: [id])
  startHour     Int
  // 0 by default — the bowling-machine recurring flow uses 30 so a
  // weekly 9:30–10:00 session can recur correctly. Both `startHour`
  // and `endHour` get a paired `*Minute` to disambiguate.
  startMinute   Int             @default(0)
  endHour       Int
  endMinute     Int             @default(0)
  dayOfWeek     Int // 0=Sun … 6=Sat
  startDate     DateTime
  endDate       DateTime? // null = indefinite (max 3 months enforced in code)
  mode          String          @default("weekly") // "weekly" or "daily"
  status        RecurringStatus @default(ACTIVE)
  bookings      Booking[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId])
  @@index([status])
}

// ===========================
// GENERATOR MANAGEMENT
// ===========================

model Generator {
  id       String  @id // manually assigned e.g. "xgen_2026"
  name     String // e.g. "Generator 1"
  isActive Boolean @default(true)

  fuelLogs   GeneratorFuelLog[]
  oilChanges GeneratorOilChange[]
  runLogs    GeneratorRunLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GeneratorConfig {
  id String @id @default(cuid())

  petrolPricePerLitre Int   @default(9500) // paise — ₹95
  oilPricePerLitre    Int   @default(29500) // paise — ₹295
  consumptionRate     Float @default(2.0) // litres per hour

  // Oil change schedule (in running hours)
  firstOilChangeHours   Int @default(20)
  secondOilChangeHours  Int @default(50) // interval after first
  regularOilChangeHours Int @default(100) // interval after second, repeating

  // Alert threshold
  oilChangeAlertHours Int @default(10) // send email when X hrs remain

  // Notification emails (comma-separated)
  notificationEmails String @default("y12.nakul@gmail.com,tangrianand@gmail.com,saxenautkarsh193@gmail.com,momentumarena2026@gmail.com")

  // MSG91 template IDs
  oilChangeTemplateId String @default("Oil_Change_Reminder")
  monthlyTemplateId   String @default("Generator_Monthly_Summary")
  pinChangeTemplateId String @default("generator_pin_change")

  // Mobile access PIN (6-digit)
  generatorPin String @default("987065")

  // Hardware API key for bulk log endpoint
  hardwareApiKey String @default("ma-gen-hw-2026-secret")

  updatedAt DateTime @updatedAt
}

model GeneratorFuelLog {
  id          String    @id @default(cuid())
  generatorId String
  generator   Generator @relation(fields: [generatorId], references: [id])

  date          DateTime @db.Date
  litres        Float // litres filled
  pricePerLitre Int // paise at time of fill
  totalCost     Int // paise (litres * pricePerLitre)

  // Fuel stock tracking
  isStockPurchase Boolean @default(false) // true = bought fuel into stock, false = filled into generator

  notes     String?
  createdAt DateTime @default(now())

  @@index([generatorId])
  @@index([date])
}

model GeneratorOilChange {
  id          String    @id @default(cuid())
  generatorId String
  generator   Generator @relation(fields: [generatorId], references: [id])

  date                 DateTime @db.Date
  runningHoursAtChange Float // total running hours when oil was changed
  litres               Float    @default(1) // oil quantity used
  costPerLitre         Int // paise at time of change
  totalCost            Int // paise
  notes                String?

  // Which change in sequence (1st, 2nd, 3rd...)
  sequenceNumber Int

  createdAt DateTime @default(now())

  @@index([generatorId])
  @@index([date])
}

// Optional: manual start/stop logging for accurate runtime tracking
model GeneratorRunLog {
  id          String    @id @default(cuid())
  generatorId String
  generator   Generator @relation(fields: [generatorId], references: [id])

  entryId Int? // sequential ID from device or auto-generated
  source  String @default("website") // "website" or "hardware"

  startTime     DateTime
  endTime       DateTime?
  durationHours Float? // calculated from start/end, or manually entered
  notes         String?

  createdAt DateTime @default(now())

  @@index([generatorId])
  @@index([startTime])
}

// ===========================
// CACHED DOCUMENTS (PDFs regenerated on a schedule, served at a public URL)
// ===========================

model CachedDocument {
  // String id so the set is extensible (SPORTS_PRICING, CAFE_MENU, ...)
  // without schema churn as new documents are added.
  id          String   @id
  content     Bytes
  mimeType    String   @default("application/pdf")
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===========================
// EXPENSES
// Internal cost tracker, modelled after the Playing Zone Mathura spend
// sheet. Replaces the Google Sheet the founders were maintaining by
// hand. Every dropdown on the UI is sourced from ExpenseOption, so
// admins can add / rename / disable categories without a redeploy.
// Amount is stored as whole rupees (Int) — same convention as
// Booking.totalAmount — not paise.
// ===========================

// Which expenses tab a row belongs to. GENERAL = the original Expenses
// module; RUNNING = the "Running Expenses" clone (same columns, its own
// blank-by-default dropdown options, month-collapsed table UI).
enum ExpenseModule {
  GENERAL
  RUNNING
}

model Expense {
  id          String        @id @default(cuid())
  module      ExpenseModule @default(GENERAL)
  // Calendar date of the expense (what would be typed into the sheet),
  // independent of createdAt which tracks row entry time.
  date        DateTime      @db.Date
  description String
  amount      Int
  // Foreign-key-lite references to ExpenseOption.label: we store the
  // label string rather than an ID so that renaming an option (or
  // hiding it) doesn't orphan historical rows, and a quick text export
  // still shows human-readable values. Filtering joins on label.
  paymentType String // e.g. "Cash" / "Online" — the old "Type" column
  doneBy      String // e.g. "Nakul" / "Utkarsh" / "Anand"
  toName      String // immediate recipient (shop / labour / driver…)
  vendor      String // money-attributed bucket ("Self" / "Landlord" / "SDA")
  spentType   String // category ("Turf" / "Rent" / "Paint"…)
  note        String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdByAdminId String?

  editHistory ExpenseEditHistory[]

  @@index([module, date])
  @@index([date])
  @@index([spentType])
  @@index([doneBy])
  @@index([vendor])
  @@index([paymentType])
}

// Audit trail for expense rows. One entry is written on CREATED, and
// another on every edit. `changes` is a JSON array of
// { field, from, to } triples so we don't need a dedicated column per
// mutable field — cheaper to extend when new Expense columns appear.
// adminId + adminUsername are denormalized so the log stays readable
// even if the AdminUser row is later deleted. adminId/username are
// nullable because CSV imports happen without a specific admin actor.
model ExpenseEditHistory {
  id            String   @id @default(cuid())
  expenseId     String
  expense       Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  adminId       String?
  adminUsername String?
  editType      String // CREATED | UPDATED
  changes       Json
  note          String?
  createdAt     DateTime @default(now())

  @@index([expenseId])
  @@index([createdAt])
}

// Which dropdown a given option feeds. Order matches the UI tabs on
// the expense config page so it's easy to reason about.
enum ExpenseOptionField {
  PAYMENT_TYPE
  DONE_BY
  VENDOR
  SPENT_TYPE
  TO_NAME
}

model ExpenseOption {
  id        String             @id @default(cuid())
  module    ExpenseModule      @default(GENERAL)
  field     ExpenseOptionField
  // Displayed + stored form of the option (e.g. "Cash"). Uniqueness
  // scoped to field so "Cash" for PAYMENT_TYPE doesn't collide with
  // the same label in a different field. Disabling (isActive=false)
  // hides the option from new-expense dropdowns but keeps historical
  // rows intact since Expense.* columns store the raw label.
  label     String
  isActive  Boolean            @default(true)
  sortOrder Int                @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([module, field, label])
  @@index([module, field, isActive])
}

// Admin overrides for automated push templates. One optional row per
// registry key (lib/push-templates.ts): absent row = defaults + enabled.
// title/body NULL = use the registry default for that part.
model PushTemplate {
  key              String   @id
  enabled          Boolean  @default(true)
  title            String?
  body             String?
  updatedAt        DateTime @updatedAt
  updatedByAdminId String?
}

// ===========================
// PUSH NOTIFICATIONS (FCM)
// ===========================
// One row per signed-in mobile device. The mobile app posts its FCM
// token after login (and on token rotation), then we use these rows
// to fan-out push payloads via Firebase Admin SDK from the existing
// notification triggers (booking confirmation, 24h/2h reminders, UPI
// verified, refund processed, etc.).
//
// `token` is unique because FCM tokens are globally unique to an
// install. When a user signs out, the row is deleted. When FCM
// returns `messaging/registration-token-not-registered` on send, the
// dead row is also deleted (background cleanup; see lib/push.ts).

// ── In-app notifications ────────────────────────────────────────────
// One row per user-facing event (added to a pass, pass-paid booking,
// booking confirmed, …). The bell icon + notification screens read
// these; a matching FCM push goes out best-effort at creation time.
model UserNotification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  // Optional in-app destination ("/account/passes/<id>", "/bookings/<id>").
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model PushDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  // "ios" | "android" — used to keep platform-specific debugging and
  // future per-platform throttling straightforward without a Prisma
  // enum migration on every new value (e.g. "web-push" later).
  platform   String
  appVersion String?
  // Bumped on every successful POST /api/mobile/devices so token-
  // pruning crons can drop devices that haven't checked in in a long
  // time (signaling app uninstall / sign-out from another device).
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([lastSeenAt])
}

/// FCM token registry for admin devices. Separate from PushDevice
/// because admins log in through AdminUser (not User), and we want
/// fan-outs to either group to be a single SQL query without
/// nullable foreign keys or a discriminator column.
///
/// A single physical device can hold rows in BOTH tables — a staffer
/// who's signed in as both customer and admin will get customer
/// pushes for their own bookings AND admin pushes for the floor's
/// queue. The unique `token` constraint is global; an FCM token only
/// ever lives in one row per table at a time, but can exist in both.
///
/// Dead-token cleanup in lib/push.ts removes from both tables when
/// FCM reports the token is no longer registered.
model AdminPushDevice {
  id         String    @id @default(cuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  token      String    @unique
  platform   String
  appVersion String?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([adminId])
  @@index([lastSeenAt])
}

/// One row per push DISPATCH — a single send call (to a user's devices,
/// the admin fleet, or a broadcast token list). Written best-effort by
/// lib/push.ts after every send; powers the Push Analytics dashboard
/// (volume, delivery rate, breakdown by kind / source / time). Counts
/// are per-dispatch, not per-device. Sends made before this log existed
/// are not captured (analytics build up from first write onward).
model PushDispatch {
  id            String   @id @default(cuid())
  kind          String // PushKind: booking_confirmed | broadcast | open_screen | cafe_order_status | ...
  scope         String // "customer" | "admin" — which device fleet it targeted
  source        String // "event" | "broadcast" | "test" — why it was sent
  audience      String? // broadcast audience descriptor (all | ios | android | group:Name | user)
  sentByAdminId String? // AdminUser.id for admin-initiated sends (broadcasts / tests)
  title         String
  body          String
  attempted     Int      @default(0)
  succeeded     Int      @default(0)
  failed        Int      @default(0)
  cleanedUp     Int      @default(0) // dead tokens pruned on this send
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([kind, createdAt])
  @@index([source, createdAt])
}

// ===========================
// FIRST-PARTY ANALYTICS
// ===========================
// Self-hosted CTA tracking + funnel + cohort + retention dashboard.
// Schema designed to be queried directly for ad-hoc lookups AND
// rolled up hourly/daily into MetricRollup for fast dashboards.
//
// Naming: `AnalyticsEvent` and `AnalyticsSession` (not just `Event`
// and `Session`) so we don't collide with NextAuth's existing
// `Session` model and to make the analytics origin obvious in code.

enum AnalyticsCategory {
  BOOKING // sport_selected, slot_toggled, proceed_to_checkout, ...
  PAYMENT // payment_initiated, payment_completed, payment_failed, ...
  AUTH // login_modal_opened, otp_submitted, login_success, ...
  CAFE // cafe_browse, item_added, cafe_payment_completed, ...
  WAITLIST // slot_unavailable_tap, waitlist_joined, ...
  REWARDS // rewards_view, rewards_redeem_started, rewards_redeem_completed
  NAVIGATION // page_view, tab_switched, deep_link_opened
  ADMIN // admin_login, admin_action_*
  ERROR // client_error, payment_error, push_subscribe_failed
  SYSTEM // session_started, session_ended, app_foreground
}

model AnalyticsSession {
  id          String    @id @default(cuid())
  userId      String? // null while anonymous; populated on first auth event
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  platform    String // "web" | "android" | "ios"
  // First-touch attribution. Captured from the URL on the first
  // page view of the session and frozen — these don't change even
  // if the user navigates around.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  // First-page context (web only). Useful for landing-page A/B and
  // referral-source analysis. Mobile leaves these null.
  landingPath String?
  referrer    String?
  // Lightweight UA parse (web). NEVER store raw UA — too much PII +
  // pointless noise. Mobile captures appVersion + osVersion instead.
  uaBrowser   String? // e.g. "Chrome", "Safari"
  uaOs        String? // e.g. "iOS", "macOS", "Windows"
  uaDevice    String? // e.g. "mobile", "desktop", "tablet"
  appVersion  String? // mobile-only
  startedAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  // Backfilled once the session ends (>30min idle on web, app-
  // background on mobile). Lets us aggregate session length without
  // recomputing from the events table.
  endedAt     DateTime?

  events AnalyticsEvent[]

  @@index([userId])
  @@index([startedAt])
  @@index([userId, startedAt])
}

model AnalyticsEvent {
  id         String            @id @default(cuid())
  // Stable machine name — keep these snake_case and grep-able.
  // Existing trackXxx() helpers in lib/analytics.ts produce names
  // like "slot_toggled", "proceed_to_checkout_click", etc.; mobile
  // mirrors the same names so funnels are platform-agnostic.
  name       String
  category   AnalyticsCategory
  // Optional FK to User. Anonymous events leave this null and
  // backfill it later via AnalyticsSession.userId once the user
  // signs in. The session FK is the join key for that backfill.
  userId     String?
  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId  String
  session    AnalyticsSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  platform   String // "web" | "android" | "ios"
  // Free-form structured payload. Per-event keys differ — keep the
  // SCHEMA documented in lib/analytics.ts (the trackXxx helper that
  // produces the event is the source of truth for what keys land
  // here). Logged user PII (name, phone) lives under `properties.user`.
  properties Json
  pageUrl    String? // web only — exact URL when event fired
  occurredAt DateTime          @default(now())

  @@index([name, occurredAt])
  @@index([sessionId, occurredAt])
  @@index([userId, occurredAt])
  // BRIN-friendly time-only index for the daily retention cron and
  // for the rollup writer's "events since last bucket" scan.
  @@index([occurredAt])
  @@index([category, occurredAt])
}

// Server-side audit trail — one row per meaningful API / server-action
// outcome. Separate from AnalyticsEvent so product funnels aren't
// polluted and we can store path/method/outcome without a session FK.
model ServerActionLog {
  id         String            @id @default(cuid())
  userId     String?
  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Dotted machine name — e.g. "booking.lock", "booking.apply_coupon".
  action     String
  category   AnalyticsCategory
  outcome    String // "success" | "error"
  path       String?
  method     String?
  platform   String // "web" | "android" | "ios"
  metadata   Json              @default("{}")
  error      String?
  occurredAt DateTime          @default(now())

  @@index([userId, occurredAt])
  @@index([action, occurredAt])
  @@index([occurredAt])
  @@index([category, occurredAt])
}

// Pre-aggregated counters keyed by (bucket, metric, dimensions).
// Written by an hourly cron — see /api/cron/rollup-metrics. Lets
// the dashboard render 90-day trends with a single indexed scan
// instead of a Big GROUP BY over every Event row.
model MetricRollup {
  id          String   @id @default(cuid())
  // Hour-aligned (or day-aligned, see bucketKind). Always UTC.
  bucketStart DateTime
  bucketKind  String // "hour" | "day"
  // Dotted name. e.g. "funnel.booking.proceed_to_checkout",
  // "kpi.bookings_confirmed", "waitlist.notified".
  metric      String
  // Group-by keys for slicing in the dashboard. Common keys:
  // { sport, platform, courtConfigId, paymentMethod }. Empty
  // object {} means "global / no slicing".
  dimensions  Json
  count       Int      @default(0)
  // Optional aggregate (e.g. revenue sum for booking_confirmed).
  // Null for pure count metrics.
  sumValue    Float?
  // Optional unique-cardinality (e.g. distinct users who hit step).
  // Null for non-uniqueness metrics.
  uniqueCount Int?

  // (bucketStart + bucketKind + metric + dimensions) is the natural
  // key. We hash dimensions to a sorted JSON string for the unique
  // index because Prisma can't unique-index Json directly.
  dimensionsKey String

  @@unique([bucketStart, bucketKind, metric, dimensionsKey])
  @@index([metric, bucketStart])
  @@index([bucketStart])
}

// Cohort assignment per user. Built once per user at first event
// (cohortStart = first session's calendar week, IST). Lets us run
// classic week-on-week retention queries in O(N) without window
// functions. Updated only when the cohort assignment is missing —
// it's frozen for the lifetime of the user.
model UserCohort {
  userId      String   @id
  user        User     @relation("UserCohortFK", fields: [userId], references: [id], onDelete: Cascade)
  // ISO week start in IST (Mon 00:00 IST). e.g. 2026-05-04T00:00 IST
  // for the week of 4-10 May 2026.
  cohortWeek  DateTime
  // Same idea, month-aligned (1st of month IST). Useful for the
  // monthly retention grid.
  cohortMonth DateTime
  // First event timestamp — handy for "how long until they did X?".
  firstSeenAt DateTime

  @@index([cohortWeek])
  @@index([cohortMonth])
}

// ===========================
// REPORT QUEUE
// ===========================
// Async monthly report generation. Admin queues a report from
// /admin/reports → cron worker (/api/cron/process-reports) drains
// the queue serially and stores the generated XLSX bytes back on
// the row. Once status flips to READY the admin can download via
// /api/admin/reports/[id]/download.
//
// Bytes are kept inline (Postgres BYTEA) instead of an external
// blob store — files are <100KB and we'd rather not pay for S3/
// Vercel Blob for a low-volume admin feature. Retention cron
// purges READY rows older than 90 days; the row stays (for audit)
// but `fileBytes` is nulled and status flips to EXPIRED.

enum ReportType {
  SALES_MONTHLY // Bookings + cafe revenue, generated from our DB.
  RAZORPAY_RECON_MONTHLY // Settlement reconciliation pulled from Razorpay.
  // Same column shape as SALES_MONTHLY — separate type so the CA's
  // copy of the books is filename-tagged for easy filing
  // ("…_ca-report.xlsx" vs the internal "…_revenue.xlsx").
  CA_MONTHLY
  // All Expense rows for the month + a per-person spend summary
  // so the operations team can see who is spending how much
  // (mapped to Expense.doneBy — the staff member who paid out).
  EXPENSES_MONTHLY
  // Same structure as EXPENSES_MONTHLY but covering every Expense
  // row ever (from day 1). `year` and `month` on the Report row
  // store the request timestamp's month for naming/ordering only —
  // the worker ignores them and pulls everything.
  EXPENSES_LIFETIME
  // Rewards liability snapshot for the calendar month — per-user
  // outstanding balance + lifetime totals + month-bucketed earn /
  // redeem / expire counts. Sheet "By user" + sheet "Summary".
  REWARD_LIABILITY_MONTHLY
  // Same shape as REWARD_LIABILITY_MONTHLY but covers every
  // RewardTransaction since the v2 schema landed. Year/month on the
  // Report row are request-timestamp only.
  REWARD_LIABILITY_LIFETIME
  // Open + resolved RewardAlert rows for the month with full details
  // JSON expanded into columns. Two sheets: "Alerts" + "By kind".
  REWARD_ALERTS_MONTHLY
  // Per-transaction ledger for the calendar month — every earn,
  // redeem, revoke, expire, and admin adjustment as one row.
  // Summary sheet rolls up by type + by IST-month so CAs can
  // reconcile against the sales / Razorpay reports.
  REWARD_TXN_LEDGER_MONTHLY
  // Same per-transaction shape as REWARD_TXN_LEDGER_MONTHLY but
  // covers every RewardTransaction ever recorded. Year/month on
  // the Report row are request-timestamp metadata only.
  REWARD_TXN_LEDGER_LIFETIME
  // Cafe item inventory + sales snapshot for the calendar month.
  // One row per CafeItem: id, name + description, total units
  // sold in the month, cash / online unit splits, current
  // on-hand stock. Replicates the /admin/analytics/cafe inventory
  // table exactly so admins can download what they see.
  CAFE_INVENTORY_MONTHLY
  // Same shape as CAFE_INVENTORY_MONTHLY but no date filter —
  // every cafe order ever. Matches the cafe analytics page's
  // DEFAULT window (earliest order → today), which is what the
  // inventory table shows out of the box. Year/month on the
  // Report row are request-timestamp metadata only.
  CAFE_INVENTORY_LIFETIME
  // (Removed 2026-07: CAFE_ITEM_SALES_MONTHLY — the CA's 3-column
  // item-sales table now ships as a sheet inside CA_MONTHLY. The
  // enum value is purged by pre-db-push-cleanup.sql.)
}

enum ReportStatus {
  QUEUED // Sitting in the queue, waiting for the worker.
  GENERATING // Worker has picked it up, currently building the XLSX.
  READY // Done — fileBytes populated, admin can download.
  FAILED // Worker hit an error — see errorMessage.
  EXPIRED // Past retention; bytes nulled but the row's kept for audit.
}

model Report {
  id            String       @id @default(cuid())
  type          ReportType
  status        ReportStatus @default(QUEUED)
  // Period the report covers — both reports are calendar-month-
  // aligned so this is the natural key to dedupe duplicate requests
  // (we don't enforce uniqueness at the DB level — admins might
  // legitimately want a fresh re-pull, e.g. after Razorpay corrects
  // a settlement).
  year          Int
  month         Int
  // Who requested it — drives the "your reports" filter on the page.
  requestedById String
  requestedBy   AdminUser    @relation("ReportRequestedBy", fields: [requestedById], references: [id])
  // Generation lifecycle timestamps.
  startedAt     DateTime?
  completedAt   DateTime?
  // Populated when status flips to FAILED.
  errorMessage  String?
  // Output metadata.
  filename      String?
  fileSizeBytes Int?
  // The generated workbook bytes. Null until the worker writes;
  // re-nulled by the retention cron after 90d.
  fileBytes     Bytes?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Drives the worker's "next job" query — pick the oldest QUEUED
  // row across the whole table.
  @@index([status, createdAt])
  @@index([requestedById, createdAt])
  @@index([type, year, month])
}

// ===========================
// SHOP — sellable products (Phase 9)
// ===========================
// Standalone module for selling items the venue keeps in inventory
// (leather balls, L-guards, etc). Lives entirely separate from the
// existing Equipment-rental flow so the two don't tangle on
// pricing, stock, or order semantics.
//
// Fulfillment is pickup-at-venue only — no shipping, no addresses.
// Stock decrements atomically when an order is placed and is
// restored if the order is cancelled.

enum ProductOrderStatus {
  PENDING // payment committed but not verified (UPI QR / cash)
  CONFIRMED // payment verified — ready for venue pickup
  FULFILLED // customer picked it up at venue
  CANCELLED // order cancelled before fulfillment
  REFUNDED // post-fulfillment refund
}

enum ProductStockMovementReason {
  SALE
  RESTOCK
  ADJUSTMENT // admin-set absolute value
  REFUND
  RELEASE // released back from a cancelled / expired order
}

model ProductCategory {
  id           String    @id @default(cuid())
  name         String
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  products     Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String  @id @default(cuid())
  name        String
  description String?

  // Per-item retail price in PAISE for the FULL item (no per-hour
  // semantics here — Equipment's `pricePerHour` is a hangover; this
  // model starts clean).
  pricePaise Int

  // Optional cost-of-goods in PAISE — what the venue paid for one
  // unit. Used by the analytics tab to compute gross profit
  // (revenue − cost × qty). Defaults to 0 so existing products
  // and tests don't have to be backfilled; admins fill it in via
  // the product edit form when they want margin reporting.
  costPaise Int @default(0)

  // Current inventory count. Decremented atomically on order
  // placement, restored on cancel. Items with stockQuantity <= 0
  // auto-hide from the customer shop unless `allowBackorder` is on
  // (placeholder for v2 — currently always false).
  stockQuantity     Int @default(0)
  // Soft floor for "low stock" UI hint. Doesn't block sale; just
  // surfaces a yellow indicator on the admin product list.
  lowStockThreshold Int @default(3)

  // Vercel Blob URL — uploaded via the admin form, not a free-text
  // input. Null until an image is uploaded; the customer shop falls
  // back to a placeholder.
  imageUrl String?

  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id])

  cartItems      CartItem[]
  orderItems     ProductOrderItem[]
  stockMovements ProductStockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, displayOrder])
  @@index([categoryId])
}

// Persisted per-user cart. Signed-out users hold the cart in
// localStorage and we merge into this on sign-in (createdAt of the
// localStorage line wins for the qty, server line for the price).
model Cart {
  id     String     @id @default(cuid())
  userId String     @unique
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  // Quantity at the time the customer added it. Server re-prices on
  // checkout against the live Product row — the cart is just a
  // basket, not a price contract.
  quantity  Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One row per (cart, product) — adding the same product again
  // bumps the quantity instead of duplicating.
  @@unique([cartId, productId])
  @@index([productId])
}

// One row per checkout. Mirrors the Booking + Payment pattern so the
// existing payment-gateway plumbing can be reused: a ProductOrder
// has a 1-to-1 Payment row of its own (see ProductOrderPayment
// below) and items[] for the line items.
model ProductOrder {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  status     ProductOrderStatus @default(PENDING)
  // Sum of items[].priceEachPaise × qty, in PAISE. Snapshot — not
  // recomputed from live Product rows after the order lands.
  totalPaise Int

  items   ProductOrderItem[]
  payment ProductOrderPayment?

  // Admin who fulfilled the order at the venue (null until pickup).
  fulfilledById String?
  fulfilledAt   DateTime?

  // Walk-in POS orders set this so reports can split "online" vs
  // "at the counter" sales. Null = regular online order.
  createdByAdminId String?

  // Soft order number for receipts / customer comms. Auto-derived
  // from createdAt + a short id slice; populated on insert.
  orderNumber String? @unique

  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model ProductOrderItem {
  id        String       @id @default(cuid())
  orderId   String
  order     ProductOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product      @relation(fields: [productId], references: [id])

  // Snapshots captured at order time so future product edits don't
  // change historical orders.
  nameSnapshot   String
  priceEachPaise Int
  // Cost-of-goods per unit at the time of sale. Frozen here so the
  // analytics view shows historical margin even after the admin
  // updates Product.costPaise. Defaults to 0 for items sold before
  // the cost field existed.
  costEachPaise  Int    @default(0)
  quantity       Int

  @@index([orderId])
  @@index([productId])
}

// Separate from the booking Payment model so the two don't collide
// on bookingId. Same gateway machinery (Razorpay/PhonePe/UPI-QR/Cash)
// can populate either.
model ProductOrderPayment {
  id      String       @id @default(cuid())
  orderId String       @unique
  order   ProductOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method PaymentMethod
  status PaymentStatus @default(PENDING)
  // Total captured in PAISE.
  amount Int

  razorpayOrderId      String?
  razorpayPaymentId    String?
  razorpaySignature    String?
  phonePeMerchantTxnId String?
  phonePeTransactionId String?
  utrNumber            String?

  confirmedAt   DateTime?
  confirmedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([razorpayPaymentId])
  @@index([phonePeMerchantTxnId])
}

// Audit trail of every stock change. Lets admins debug "where did
// my inventory go" without grepping the order table.
model ProductStockMovement {
  id        String                     @id @default(cuid())
  productId String
  product   Product                    @relation(fields: [productId], references: [id])
  // Signed delta — negative for SALE / ADJUSTMENT-down, positive
  // for RESTOCK / RELEASE / REFUND.
  delta     Int
  reason    ProductStockMovementReason
  // FK back to the order that caused the movement, when relevant.
  orderId   String?
  note      String?
  // AdminUser.id when the movement was admin-initiated.
  adminId   String?

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────────────────
// OTA updates (self-hosted Expo Updates server). An OtaRelease is one
// published JS bundle for a (channel, platform, runtimeVersion); the admin
// "Roll out" button flips status→PUBLISHED + rolloutPercent. The manifest
// endpoint serves the newest PUBLISHED release the requesting install is
// bucketed into. See lib/ota/*.
// ─────────────────────────────────────────────────────────────────────────

enum OtaPlatform {
  ios
  android
}

enum OtaReleaseKind {
  UPDATE // normal manifest
  ROLLBACK // emit rollBackToEmbedded directive (revert to the store binary's bundle)
}

enum OtaReleaseStatus {
  DRAFT // uploaded, not yet servable
  PUBLISHED // live, subject to rolloutPercent gating
  ARCHIVED // retired, never served
}

model OtaRelease {
  // Used verbatim as the Expo manifest "id" (must be UUID-shaped).
  id             String           @id @default(uuid())
  channel        String // expo-channel-name, e.g. "production" | "development"
  runtimeVersion String // expo-runtime-version, e.g. "1.0.0" — must match the native build
  platform       OtaPlatform
  kind           OtaReleaseKind   @default(UPDATE)
  status         OtaReleaseStatus @default(DRAFT)
  rolloutPercent Int              @default(0) // 0..100, sticky per install
  sequence       Int              @default(0) // OTA build number within (channel, platform, runtimeVersion); stamped into manifest extra.otaBuildNumber

  // Launch asset = the JS bundle.
  launchAssetKey         String // md5 hex
  launchAssetHash        String // base64url sha256
  launchAssetUrl         String // Vercel Blob URL
  launchAssetContentType String @default("application/javascript")

  metadata    Json      @default("{}") // manifest.metadata
  extra       Json      @default("{}") // manifest.extra (e.g. { expoClient })
  commitTime  DateTime? // rollBackToEmbedded.parameters.commitTime
  changelog   String?
  publishedBy String? // AdminUser.id who rolled it out

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  activatedAt DateTime? // first time it went PUBLISHED

  assets OtaReleaseAsset[]

  @@index([channel, runtimeVersion, platform, status, createdAt])
}

model OtaReleaseAsset {
  id            String     @id @default(cuid())
  release       OtaRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  releaseId     String
  key           String // md5 hex → manifest asset.key
  hash          String // base64url sha256 → manifest asset.hash
  url           String // Vercel Blob URL
  contentType   String
  fileExtension String // ".png", etc.

  @@unique([releaseId, key])
  @@index([releaseId])
}

// Native-binary version gate, per (platform, channel). Drives /api/app/version-check:
// the app reports its installed native build number and gets back whether a store
// update is available and whether it is FORCED (build < minSupportedBuild → blocking
// "Update Required" screen). latestBuild is bumped when a new store build ships;
// minSupportedBuild is raised by an admin ONLY after that build is live on the store.
model AppVersionGate {
  id                String      @id @default(cuid())
  platform          OtaPlatform
  channel           String // "development" | "production"
  latestBuild       Int // newest native build number available on the store
  latestVersionName String? // marketing version of the latest build, e.g. "1.0.0"
  // Uploading a binary is NOT the same as it being downloadable: App Store
  // review takes hours-to-days, and our Play uploads land as drafts. CI records
  // the build with latestIsLive=false, so no "update available" prompt fires
  // until the store actually serves it — confirmed hourly by
  // scripts/check-store-availability.ts, or by hand from /admin/ota.
  latestIsLive      Boolean     @default(false)
  liveConfirmedAt   DateTime? // when we saw this build live on the store
  minSupportedBuild Int         @default(0) // installed build < this → forced update
  storeUrl          String // App Store / Play Store deep link
  message           String? // optional custom copy for the update prompt
  updatedBy         String? // AdminUser.id
  updatedAt         DateTime    @updatedAt
  createdAt         DateTime    @default(now())

  @@unique([platform, channel])
}

// ── HR / Legal ──────────────────────────────────────────────────────
// Employee master record — the source of truth the NDA and offer-letter
// generators select from (/admin/employees manages it). The Aadhaar is
// stored ENCRYPTED at rest (aadhaarEnc = AES-256-GCM ciphertext via
// lib/hr-crypto) and decrypted only when rendering an NDA; aadhaarLast4
// is kept in clear for display/audit. Salary is a gross monthly figure
// in whole rupees.
model Employee {
  id            String    @id @default(cuid())
  name          String
  phone         String
  email         String
  address       String
  aadhaarEnc    String? // AES-256-GCM ciphertext "v1:iv:tag:data" of the full Aadhaar
  aadhaarLast4  String? // last 4 digits, for display/audit
  designation   String?
  department    String?
  salaryMonthly Int? // gross ₹ per month
  dateOfJoining DateTime?
  status        String    @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ndaRecords            NdaRecord[]
  offerRecords          OfferLetterRecord[]
  responsibilityRecords ResponsibilityLetterRecord[]

  @@index([status])
}

// Audit trail of employee NDAs generated from /admin/nda. Keeps a snapshot
// of what was printed (stable even if the employee record later changes)
// plus the last-4 Aadhaar only, and links back to the Employee.
model NdaRecord {
  id              String    @id @default(cuid())
  employeeId      String?
  employee        Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  employeeName    String
  employeePhone   String
  employeeEmail   String
  employeeAddress String
  aadhaarLast4    String // last 4 digits ONLY on the record — full Aadhaar lives encrypted on Employee
  ndaVersion      String
  generatedById   String
  generatedByName String
  createdAt       DateTime  @default(now())

  @@index([createdAt])
  @@index([employeeId])
}

// Audit trail of offer letters generated from /admin/offer-letter.
model OfferLetterRecord {
  id              String    @id @default(cuid())
  employeeId      String?
  employee        Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  employeeName    String
  designation     String
  salaryMonthly   Int
  dateOfJoining   DateTime?
  offerVersion    String
  generatedById   String
  generatedByName String
  createdAt       DateTime  @default(now())

  @@index([createdAt])
  @@index([employeeId])
}

// Catalogue of responsibility items an admin maintains (/admin/responsibilities).
// When generating a Responsibility Letter, the admin ticks a subset of the
// ACTIVE items to assign to the employee. Disabling an item hides it from the
// picker without deleting past letters (which snapshot the chosen text).
model ResponsibilityItem {
  id        String   @id @default(cuid())
  text      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// Audit trail of responsibility letters generated from
// /admin/responsibility-letter. `responsibilities` is a snapshot of the chosen
// item texts, so history is stable even if the catalogue later changes.
model ResponsibilityLetterRecord {
  id               String    @id @default(cuid())
  employeeId       String?
  employee         Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  employeeName     String
  designation      String?
  responsibilities String[]
  letterVersion    String
  generatedById    String
  generatedByName  String
  createdAt        DateTime  @default(now())

  @@index([createdAt])
  @@index([employeeId])
}

// ── Tournaments ─────────────────────────────────────────────────────
// Full tournament engine: admin-configured tournaments (league / knockout /
// pools→knockout), captain-paid team registration, pools with a timed
// animated reveal, fixtures that block the booking grid, a configurable
// points table, per-player stats, and OPTIONAL live scoring (ball-by-ball /
// goal-by-goal / point-by-point) with audience live screens whose platform
// availability (app/web) is admin-gated per tournament.

enum TournamentFormat {
  LEAGUE // single round-robin table, no bracket
  KNOCKOUT // bracket only
  POOLS_KNOCKOUT // round-robin pools feeding a knockout bracket
}

/// How pool qualifiers are seeded into the knockout bracket.
enum BracketSeeding {
  /// A1, B1, C1… — the pool's letter decides the seed. Keeps same-pool
  /// teams apart, but Pool A's winner always takes seed 1.
  POOL_ORDER
  /// Qualifiers ranked against each other on their pool record (points,
  /// then the tournament's tiebreaker chain), so the strongest team
  /// overall takes seed 1 — and with it any first-round bye.
  OVERALL_RANK
}

enum TournamentStatus {
  DRAFT
  PUBLISHED // visible, registrations not yet open
  REG_OPEN
  REG_CLOSED
  POOLS_REVEALED
  LIVE
  COMPLETED
  CANCELLED
}

/// Who runs the tournament. VENUE is everything we've built so far: we
/// own it, teams register with us and pay entry fees. THIRD_PARTY is an
/// outside organiser hiring the venue — they handle their own teams and
/// entry money, hand us dates + slots, and pay US a quoted hire fee in
/// instalments. Every other tournament feature (draw, fixtures, scoring,
/// match centre) works identically for both.
enum TournamentHost {
  VENUE
  THIRD_PARTY
}

enum TournamentFeeMode {
  FULL // whole entry fee online to confirm
  ADVANCE // advancePct online, rest collected at venue
  FREE // no fee
}

enum LiveScreenPlatform {
  BOTH
  APP_ONLY // web shows an app-download upsell instead of the live screen
  WEB_ONLY
  OFF
}

enum TournamentTeamStatus {
  PENDING_PAYMENT
  CONFIRMED
  WAITLISTED
  WITHDRAWN
  REJECTED
}

enum TournamentMatchStage {
  LEAGUE
  POOL
  R16
  QF
  SF
  THIRD_PLACE
  FINAL
}

enum TournamentMatchStatus {
  SCHEDULED
  LIVE
  COMPLETED
  WALKOVER
  CANCELLED
}

model Tournament {
  id     String           @id @default(cuid())
  slug   String           @unique // public URL: /tournaments/[slug]
  name   String
  sport  Sport
  status TournamentStatus @default(DRAFT)
  format TournamentFormat

  description    String?
  rules          String? // rich text (markdown) shown on the public page
  bannerImageUrl String? // hero image (web + app)

  // Capacity & structure
  totalTeams        Int
  poolCount         Int            @default(0) // POOLS_KNOCKOUT only
  teamsPerPool      Int            @default(0)
  advancePerPool    Int            @default(0) // how many qualify from each pool
  thirdPlaceMatch   Boolean        @default(false)
  /// POOLS_KNOCKOUT: how the qualifiers are seeded into the bracket.
  bracketSeeding    BracketSeeding @default(POOL_ORDER)
  membersPerTeamMin Int            @default(1)
  membersPerTeamMax Int
  /// Cricket: overs one bowler may bowl in a match. 0 = no limit. The
  /// scorer console greys out a bowler once they've bowled their quota.
  maxOversPerBowler Int            @default(0)
  /// Cricket: overs per side. 0 = unlimited. The innings closes on the
  /// last legal ball, and the scorer can't bowl past it. A match may
  /// override this at start time (Match.oversPerInnings).
  oversPerInnings   Int            @default(0)
  /// Cricket: wickets a side has per innings. Ten is standard, but a
  /// short-format tournament with 8–10 a side plays fewer — Momentum's
  /// own cup is 8. This is NOT cosmetic: it decides when a side is all
  /// out, which drives the "won by N wickets" margin and the ICC rule
  /// that charges an all-out side its FULL over quota for Net Run Rate.
  /// Hardcoding ten silently skipped that rule and mis-stated NRR.
  wicketsPerInnings Int            @default(10)

  /// VENUE (default) or THIRD_PARTY. On THIRD_PARTY the public page
  /// drops registration entirely and entryFee is pinned to 0 — the
  /// organiser collects entry money themselves, off our books.
  host TournamentHost @default(VENUE)

  // Third-party organiser (THIRD_PARTY only; null on our own events)
  organizerName  String?
  organizerPhone String?
  organizerEmail String?
  /// What we quoted them for the hire, rupees. Receipts against it are
  /// TournamentOrganizerPayment rows; outstanding = quoted - received.
  quotedAmount   Int     @default(0)
  organizerNote  String?

  // Fees
  entryFee          Int               @default(0) // rupees
  feeMode           TournamentFeeMode @default(FULL)
  advancePct        Int               @default(50) // ADVANCE mode: % online
  allowCoupons      Boolean           @default(true)
  allowRewardPoints Boolean           @default(true)
  waitlistEnabled   Boolean           @default(true)

  // Timeline
  regOpenAt  DateTime?
  regCloseAt DateTime?
  revealAt   DateTime? // pool-reveal countdown target
  startDate  DateTime?
  endDate    DateTime?

  /// How long one pool/league match occupies a slot, in minutes. A
  /// 6-10am window therefore yields (4*60)/duration match slots. Only
  /// one tournament match runs at a time (venue rule), so this is the
  /// sole capacity input alongside the windows themselves.
  matchDurationMinutes Int       @default(60)
  /// Set when an admin approves a generated draw+schedule. Until then
  /// the generated plan is a proposal and nothing is revealed.
  scheduleApprovedAt   DateTime?

  // Points engine (round-robin stages)
  pointsWin   Int      @default(2)
  pointsDraw  Int      @default(1)
  pointsLoss  Int      @default(0)
  // Ordered tiebreaker chain applied after points. Keys:
  // H2H | SCORE_DIFF | SCORE_FOR | NAME
  tiebreakers String[] @default(["H2H", "SCORE_DIFF", "SCORE_FOR"])

  // Per-player stat fields the admin defines for this tournament, e.g.
  // [{"key":"runs","label":"Runs"},{"key":"wickets","label":"Wickets"}].
  // Leaderboards aggregate TournamentPlayerStat rows by these keys.
  statFields Json?

  // Prizes
  prizePool Int? // total, rupees (display)
  // [{"place":"Winner","label":"₹20,000 + Trophy"}, ...]
  prizes    Json?

  // Live scoring (optional per tournament)
  liveScoringEnabled Boolean            @default(false)
  liveScreenPlatform LiveScreenPlatform @default(BOTH)
  scorerCode         String?            @unique // field-scorer console access

  createdBy String? // admin id
  /// Set when an admin files the tournament away. It keeps every record —
  /// teams, fixtures, scores, money — but drops out of the admin list and
  /// the public tournaments list, so a finished season stops crowding the
  /// screen. A direct link still resolves, deliberately: old links and
  /// bookmarks keep working. Nullable rather than a boolean so the "when"
  /// is recoverable.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pools             TournamentPool[]
  teams             TournamentTeam[]
  matches           TournamentMatch[]
  slots             TournamentSlot[]
  playerStats       TournamentPlayerStat[]
  campaignItems     TournamentCampaignItem[]
  organizerPayments TournamentOrganizerPayment[]

  @@index([status])
  @@index([sport, status])
}

/// One receipt from a third-party organiser against Tournament.quotedAmount.
///
/// A table rather than advanceAmount/balanceAmount columns on Tournament:
/// "some advance, rest afterward" is two rows today but three or four is
/// routine, and each receipt needs its OWN date. Analytics and the CA
/// report are cash-basis, so money handed over in September has to land in
/// September — two fixed columns can't express that, and the same reasoning
/// is why TournamentTeam carries paidAt instead of leaning on updatedAt.
model TournamentOrganizerPayment {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  /// Rupees. Always positive — a correction is a delete, not a negative row.
  amount     Int
  /// CASH | BANK_TRANSFER | UPI | CHEQUE | RAZORPAY
  method     String
  /// UTR / cheque number / txn id, whatever the method gives us.
  reference  String?
  /// When the money actually arrived. This is the cash-basis date every
  /// revenue query keys on — NOT createdAt, which is merely when an admin
  /// got round to typing it in.
  receivedAt DateTime
  note       String?
  recordedBy String? // admin user id

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tournamentId])
  @@index([receivedAt])
}

/// A window the admin pre-decides for pool/league matches — e.g.
/// "Sat 6-10am". Semi-finals and the final are scheduled by hand and
/// deliberately do NOT draw from these.
model TournamentSlot {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  date      DateTime @db.Date
  startHour Int
  /// Exclusive. 22 means the window ends at 10pm.
  endHour   Int

  /// Court these matches run on. Needed to raise the SlotBlock that
  /// keeps the public booking grid from selling the same hour.
  courtConfigId String?
  courtConfig   CourtConfig? @relation(fields: [courtConfigId], references: [id], onDelete: SetNull)

  /// Optional admin label ("Saturday morning") for the customer page.
  label String?

  /// SlotBlock rows raised the moment this window is created, so the
  /// public booking grid stops selling those hours immediately —
  /// waiting until the draw is approved left them on sale.
  slotBlockIds String[] @default([])

  createdAt DateTime @default(now())

  @@index([tournamentId, date, startHour])
}

model TournamentPool {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String // "Pool A"
  order        Int        @default(0)

  teams   TournamentTeam[]
  matches TournamentMatch[]

  @@unique([tournamentId, name])
  @@index([tournamentId])
}

/// Captain-selected windows the team can play in. Referenced by id
/// rather than a join table: the set is small, admin-owned, and always
/// read together with the team.
model TournamentTeam {
  id           String               @id @default(cuid())
  tournamentId String
  tournament   Tournament           @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  poolId       String?
  pool         TournamentPool?      @relation(fields: [poolId], references: [id], onDelete: SetNull)
  status       TournamentTeamStatus @default(PENDING_PAYMENT)

  name    String
  logoUrl String?
  color   String? // hex, jersey/badge colour
  seed    Int? // draw order / bracket seed

  captainUserId String? // customer User.id
  captainName   String
  captainPhone  String
  captainEmail  String?

  // Money (rupees). paidAmount accumulates (advance + venue collection).
  paidAmount    Int       @default(0)
  dueAmount     Int       @default(0)
  paymentMethod String? // RAZORPAY | UPI_DQR | CASH | FREE ...
  paymentRef    String? // razorpay payment id / phonePe merchantTxnId
  // When the money actually arrived — the CASH-BASIS date analytics and
  // the CA report key on. updatedAt can't serve: it moves on every later
  // edit, which would silently reassign revenue to another month.
  paidAt        DateTime?
  couponCode    String?
  discount      Int       @default(0)
  pointsUsed    Int       @default(0)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  // Soft-delete for admins: an archived team drops out of the roster and
  // every count without destroying its payment trail or match history.
  // Hard delete stays available only while a team has neither.
  archivedAt DateTime?

  members          TournamentTeamMember[]
  homeMatches      TournamentMatch[]      @relation("homeTeam")
  awayMatches      TournamentMatch[]      @relation("awayTeam")
  wonMatches       TournamentMatch[]      @relation("winnerTeam")
  playerStats      TournamentPlayerStat[]
  /// TournamentSlot ids the captain ticked. Empty = no preference
  /// expressed, which the generator treats as "available for any".
  preferredSlotIds String[]               @default([])

  @@index([tournamentId, status])
  @@index([captainUserId])
}

model TournamentTeamMember {
  id        String         @id @default(cuid())
  teamId    String
  team      TournamentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name      String
  // Optional: squads are often built before every number is known, and a
  // missing phone must never block registration. Used by the venue to
  // reach a player when the captain isn't around.
  phone     String?
  isCaptain Boolean        @default(false)
  order     Int            @default(0)

  playerStats TournamentPlayerStat[]
  potmMatches TournamentMatch[]      @relation("playerOfMatch")
  matchEvents TournamentMatchEvent[]

  @@index([teamId])
}

model TournamentMatch {
  id           String                @id @default(cuid())
  tournamentId String
  tournament   Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  poolId       String?
  pool         TournamentPool?       @relation(fields: [poolId], references: [id], onDelete: SetNull)
  stage        TournamentMatchStage
  status       TournamentMatchStatus @default(SCHEDULED)
  sequence     Int                   @default(0) // display order within stage
  roundLabel   String? // "Match 3", "Semi Final 1"

  homeTeamId String?
  homeTeam   TournamentTeam? @relation("homeTeam", fields: [homeTeamId], references: [id], onDelete: SetNull)
  awayTeamId String?
  awayTeam   TournamentTeam? @relation("awayTeam", fields: [awayTeamId], references: [id], onDelete: SetNull)

  // Bracket progression: where each side comes from when not yet decided.
  // KO chains: winner of another match. Pools→KO seeding: pool + rank.
  homeSourceMatchId String?
  awaySourceMatchId String?
  homeSourceLabel   String? // "Winner Pool A", "Winner SF1" (display until resolved)
  awaySourceLabel   String?

  // Schedule → booking-grid integration
  courtConfigId String?
  courtConfig   CourtConfig? @relation(fields: [courtConfigId], references: [id], onDelete: SetNull)
  scheduledAt   DateTime?
  durationMins  Int          @default(60)
  slotBlockIds  String[]     @default([]) // SlotBlock rows created for this match

  // Result
  homeScore     Int?
  awayScore     Int?
  // Sport-specific score labels, e.g. cricket "142/7 (16.0)" — the numeric
  // homeScore/awayScore stay canonical for points/tiebreakers.
  homeScoreNote String?
  awayScoreNote String?
  isDraw        Boolean         @default(false)
  winnerTeamId  String?
  winnerTeam    TournamentTeam? @relation("winnerTeam", fields: [winnerTeamId], references: [id], onDelete: SetNull)
  resultNote    String?

  playerOfMatchId String?
  playerOfMatch   TournamentTeamMember? @relation("playerOfMatch", fields: [playerOfMatchId], references: [id], onDelete: SetNull)

  /// Cricket: overs per side for THIS match, captured when the scorer
  /// starts it. Null falls back to the tournament's figure — rain, a
  /// late start or a knockout played long are per-match facts, and the
  /// innings cap plus the Net Run Rate quota both have to follow the
  /// overs actually played, not the ones originally scheduled.
  oversPerInnings Int?

  // Live scoring state
  // liveState: sport-specific snapshot folded from events, e.g. cricket
  // {inning, battingTeamId, runs, wickets, balls, target} — kept denormalised
  // so audience screens read ONE row + recent events.
  liveState       Json?
  clockStartedAt  DateTime? // football: running-clock anchor (null = paused)
  clockElapsedSec Int       @default(0) // accumulated paused-at seconds

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events      TournamentMatchEvent[]
  playerStats TournamentPlayerStat[]

  @@index([tournamentId, stage, sequence])
  @@index([tournamentId, status])
  @@index([scheduledAt])
}

// Append-only live-scoring event log. The score is a fold of events in seq
// order — undo deletes the highest seq and re-folds, so the on-field scorer
// can always correct a mistake. kind examples:
//  cricket: BALL {runs, extra?, wicket?, batterId?, bowlerId?}
//  football: GOAL {teamId, memberId?}, CARD {...}, CLOCK_START, CLOCK_STOP
//  pickleball: POINT {teamId}, GAME_END
model TournamentMatchEvent {
  id        String                @id @default(cuid())
  matchId   String
  match     TournamentMatch       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  seq       Int
  kind      String
  teamId    String?
  memberId  String?
  member    TournamentTeamMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  data      Json?
  createdBy String // admin id or "scorer"
  createdAt DateTime              @default(now())

  @@unique([matchId, seq])
  @@index([matchId, seq])
}

// Per-player per-match stat values, aggregated for leaderboards. Written by
// admin score entry and by the live-scoring fold (kept in sync with events).
model TournamentPlayerStat {
  id           String               @id @default(cuid())
  tournamentId String
  tournament   Tournament           @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matchId      String
  match        TournamentMatch      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId       String
  team         TournamentTeam       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  memberId     String
  member       TournamentTeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  statKey      String // matches Tournament.statFields[].key
  value        Int

  @@unique([matchId, memberId, statKey])
  @@index([tournamentId, statKey])
}

// Milestone marketing items auto-drafted when a tournament is created
// (registrations-open banner+push, closing-soon, reveal, results, champion…).
// Admin edits copy / toggles / schedules each; firing reuses the existing
// PromoBanner + push systems. status: DRAFT | SCHEDULED | SENT | SKIPPED.
model TournamentCampaignItem {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  milestone    String // REG_OPEN | REG_CLOSING | REVEAL_TONIGHT | REVEALED | MATCHDAY | CHAMPION ...
  kind         String // BANNER | PUSH
  title        String
  body         String?
  imageUrl     String?
  enabled      Boolean    @default(true)
  status       String     @default("DRAFT")
  scheduledAt  DateTime?
  sentAt       DateTime?
  bannerId     String? // PromoBanner created when fired

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tournamentId, milestone])
}

// ── Coaching camps ──────────────────────────────────────────────────
// A camp is a fixed-length coaching programme (e.g. "Summer Cricket
// Camp, 15 days") that people register FOR — not a slot they book. It
// deliberately reuses the tournament module's money vocabulary
// (feeMode/advancePct, coupons, reward points, waitlist) so the venue's
// mental model and the reporting stay the same, without dragging in
// pools, fixtures or scoring, which a camp has no use for.

enum CampStatus {
  DRAFT
  REGISTRATIONS_OPEN
  REGISTRATIONS_CLOSED
  ONGOING
  COMPLETED
  CANCELLED
}

enum CampRegistrationStatus {
  PENDING_PAYMENT
  CONFIRMED
  WAITLISTED
  WITHDRAWN
  REJECTED
}

model Camp {
  id             String     @id @default(cuid())
  slug           String     @unique
  name           String
  sport          Sport
  status         CampStatus @default(DRAFT)
  description    String?
  rules          String?
  bannerImageUrl String?

  // Schedule. Sessions repeat on `daysOfWeek` (0=Sun … 6=Sat) between
  // startHour and endHour, across the startDate..endDate window.
  startDate  DateTime
  endDate    DateTime
  daysOfWeek Int[]
  startHour  Int
  endHour    Int
  regOpenAt  DateTime?
  regCloseAt DateTime?

  // Who it's for.
  ageMin    Int?
  ageMax    Int?
  coachName String?
  venueNote String?

  // Money (rupees), mirroring the tournament fee model.
  capacity          Int
  fee               Int     @default(0)
  feeMode           String  @default("FULL") // FULL | ADVANCE | FREE
  advancePct        Int     @default(50)
  allowCoupons      Boolean @default(true)
  allowRewardPoints Boolean @default(true)
  waitlistEnabled   Boolean @default(true)

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registrations CampRegistration[]

  @@index([status, startDate])
}

model CampRegistration {
  id     String                 @id @default(cuid())
  campId String
  camp   Camp                   @relation(fields: [campId], references: [id], onDelete: Cascade)
  status CampRegistrationStatus @default(PENDING_PAYMENT)

  // The account that registered (null for a walk-in an admin entered).
  userId String?

  participantName String
  participantAge  Int?
  guardianName    String?
  phone           String
  email           String?
  notes           String?

  // Money — accumulates like a tournament team: advance online, the rest
  // collected at the venue.
  paidAmount    Int       @default(0)
  dueAmount     Int       @default(0)
  paymentMethod String?
  paymentRef    String?
  // Cash-basis date the money arrived (see TournamentTeam.paidAt).
  paidAt        DateTime?
  couponCode    String?
  discount      Int       @default(0)
  pointsUsed    Int       @default(0)

  // Soft delete, so a withdrawn registration keeps its payment trail.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campId, status])
  @@index([userId])
}

// ── Public (casual) match scoring ────────────────────────────────────
// Anyone playing at the arena can spin up a scratch match and score it
// from their phone. Deliberately SEPARATE from the tournament scoring
// path: tournament matches are scored only by whoever holds the
// admin-issued, rotatable scorerCode, and nothing here can touch them.

enum PublicMatchStatus {
  LIVE
  COMPLETED
  ABANDONED
}

model PublicMatch {
  id     String            @id @default(cuid())
  // Short shareable code — friends open the live view with it.
  code   String            @unique
  sport  Sport
  status PublicMatchStatus @default(LIVE)

  teamAName String
  teamBName String

  // Only the creator can score; everyone else with the code watches.
  createdByUserId String?

  // Cricket only.
  oversPerInnings Int?

  // Compact scoreboard, plus an append-only event log that makes undo a
  // replay rather than a guess at what to subtract.
  state  Json
  events Json

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([status, createdAt])
  @@index([createdByUserId])
}
