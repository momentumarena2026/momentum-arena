generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum Sport {
  CRICKET
  FOOTBALL
  PICKLEBALL
}

enum ConfigSize {
  XS
  SMALL
  MEDIUM
  LARGE
  XL
  FULL
  SHARED
}

enum CourtZone {
  LEATHER_1
  BOX_A
  BOX_B
  LEATHER_2
  SHARED_COURT
}

enum BookingStatus {
  PENDING // UPI/cash committed, awaiting admin verification
  CONFIRMED // paid & verified — slot is booked
  CANCELLED // admin-cancelled, refunded, or UPI rejected
  // Terminal post-session statuses set by admin. Both retain the
  // advance as earnings (no refund); the Payment row flips to
  // COMPLETED with whatever the customer already paid and any
  // remainder is forfeit. Distinct values so reports can split
  // "completed" attendance from "no-show" attendance.
  COMPLETED // customer attended; admin closed the booking out
  ABSENT // customer did not show up
}

enum PaymentMethod {
  RAZORPAY
  PHONEPE
  UPI_QR
  CASH
  FREE
}

enum PaymentGateway {
  PHONEPE
  RAZORPAY
}

model PaymentGatewayConfig {
  id             String         @id @default("singleton")
  activeGateway  PaymentGateway @default(PHONEPE)
  // Per-method enablement flags. All default on so existing installs keep
  // their behavior. Admin can toggle any of these off via the Payment
  // Settings page. At least one must stay enabled (enforced server-side).
  onlineEnabled  Boolean        @default(true)
  upiQrEnabled   Boolean        @default(true)
  advanceEnabled Boolean        @default(true)
  updatedAt      DateTime       @updatedAt
}

enum PaymentStatus {
  PENDING
  // Advance received, remainder still owed (collected at venue for sports
  // bookings, or awaiting a second capture elsewhere). Flips to COMPLETED
  // once the remaining amount is collected via markRemainderCollected.
  PARTIAL
  COMPLETED
  REFUNDED
  FAILED
}

enum DayType {
  WEEKDAY
  WEEKEND
}

// Sub-category of bookings within the CRICKET sport. Used to keep
// the two Cricket flows distinct without growing the Sport enum:
//   - BOX_CRICKET  : the regular full-pitch / half-court cricket
//                    bookings (1-hour slots).
//   - BOWLING_MACHINE : 30-minute bowling-machine practice that
//                    occupies a thin 10×90 strip and zone-blocks
//                    one of the half-courts (and therefore the
//                    full field) for the booked window.
//
// Nullable on Coupon / Booking / CourtConfig — non-cricket configs
// stay null, and any code that doesn't care about the split treats
// `null` and `BOX_CRICKET` interchangeably.
enum BookingCategory {
  BOX_CRICKET
  BOWLING_MACHINE
}

enum TimeType {
  PEAK
  OFF_PEAK
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum BannerPlacement {
  BOOK_PAGE
  SLOT_SELECTION
  CHECKOUT
}

enum AdminRole {
  SUPERADMIN
  ADMIN
  STAFF
}

// ===========================
// UNIFIED COUPON SYSTEM
// ===========================

enum CouponScope {
  SPORTS
  CAFE
  BOTH
}

enum CouponConditionType {
  MIN_AMOUNT
  FIRST_PURCHASE
  USER_GROUP
  SPORT_SPECIFIC
  CATEGORY_SPECIFIC
  TIME_WINDOW
  BIRTHDAY
  REFERRAL
}

enum UserGroupType {
  FIRST_TIME
  PREMIUM_PLAYER
  FREQUENT_VISITOR
  BIRTHDAY_MONTH
  CUSTOM
}

// ===========================
// REWARD POINTS (v2 — full rewrite)
// ===========================
// The old RewardTier / PointsTransactionType / RewardPointsBalance /
// PointsTransaction / RewardConfig set was dropped — see
// migration 20260512010000_drop_old_rewards_create_v2 for the data
// teardown.

enum RewardTxnType {
  // Credits
  EARNED_BOOKING
  // Top-up credit for partial-pay bookings — fires when admin marks
  // the remainder collected at the venue. Sits alongside the initial
  // EARNED_BOOKING (awarded on the advance) so the customer ends up
  // with points proportional to the FULL amount they actually paid.
  // Separate type so @@unique([type, bookingId]) doesn't collide
  // with the initial award row.
  EARNED_BOOKING_REMAINDER
  EARNED_CAFE
  EARNED_SIGNUP
  EARNED_REFERRAL
  EARNED_BIRTHDAY
  EARNED_ADJUSTMENT // admin grants points (bulk distribute / one-off)
  ADJUSTMENT_REFUND // re-credit after a cancelled redemption
  // Debits
  REDEEMED_BOOKING
  REDEEMED_CAFE
  REVOKED // earn clawed back (booking refund/cancel)
  EXPIRED // expiry cron sweep
  ADJUSTMENT_DEBIT // admin debits manually
}

enum RewardAlertKind {
  RAPID_EARN_REDEEM // earned + redeemed within `earnToRedeemMinHours`
  HIGH_VELOCITY_EARN // > threshold points earned in 24h
  REFUND_THEN_RETAIN // booking refunded but earn wasn't auto-revoked
  DUPLICATE_PHONE_USERS // >1 User row on same normalised phone
  BULK_REDEMPTION // single redemption > threshold
  NEGATIVE_BALANCE // shouldn't happen; if it does, page an admin
  PARTIAL_REVOKE_SHORTFALL // revoke wanted N, only N-K was available
  ADJUSTMENT_AUDIT // surfaces every manual admin ADJUSTMENT
}

enum RewardAlertStatus {
  OPEN
  DISMISSED
  ACTIONED
}

enum RewardAlertSeverity {
  LOW
  MEDIUM
  HIGH
}

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String?     @unique
  phone         String?     @unique
  emailVerified DateTime?
  phoneVerified DateTime?
  image         String?
  passwordHash  String?
  passwordSetAt DateTime?
  role          UserRole    @default(CUSTOMER)
  accounts      Account[]
  sessions      Session[]
  bookings      Booking[]
  slotHolds     SlotHold[]
  cafeOrders    CafeOrder[]
  referralCode  String?     @unique
  referredBy    String?
  birthday      DateTime?

  rewardBalance      RewardBalance?
  rewardTransactions RewardTransaction[]
  rewardAlerts       RewardAlert[]

  // New feature relations
  feedbacks         Feedback[]
  waitlistEntries   Waitlist[]
  recurringBookings RecurringBooking[]

  // Admin-curated targeting for coupons (vs the auto-computed
  // UserGroupType buckets like FIRST_TIME). `groupMemberships` lets
  // an admin drop a user into named cohorts ("VIP Customers",
  // "Tournament Players"); `couponEligibilities` is a direct,
  // per-user assignment that bypasses any group routing.
  groupMemberships    UserGroupMember[]
  couponEligibilities CouponEligibleUser[]

  // FCM push tokens for the mobile app — one row per device the user
  // signs into. Tokens rotate (FCM may invalidate them); the mobile
  // client reposts on rotation, and dead tokens are pruned when FCM
  // returns `messaging/registration-token-not-registered`.
  pushDevices PushDevice[]

  // First-party analytics — every event the user fires (web + mobile)
  // and every session they've been part of. Anonymous events have
  // null userId until sign-in, then we backfill via the
  // AnalyticsSession's userId once the auth event lands.
  analyticsEvents   AnalyticsEvent[]
  analyticsSessions AnalyticsSession[]
  serverActionLogs  ServerActionLog[]
  // Cohort assignment — frozen at first event. Used for week-on-week
  // and month-on-month retention queries in the analytics dashboard.
  cohort            UserCohort?        @relation("UserCohortFK")

  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  cart          Cart?
  productOrders ProductOrder[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  attempts   Int      @default(0)

  @@unique([identifier, token])
}

model RateLimit {
  id          String   @id @default(cuid())
  identifier  String
  action      String
  count       Int      @default(1)
  windowStart DateTime @default(now())

  @@unique([identifier, action])
}

model CourtConfig {
  id       String      @id @default(cuid())
  sport    Sport
  size     ConfigSize
  label    String
  position String
  widthFt  Int
  lengthFt Int         @default(90)
  zones    CourtZone[]
  isActive Boolean     @default(true)

  // Within CRICKET, this distinguishes the regular Box-Cricket
  // configs (full field + the two half courts) from the
  // Bowling-Machine practice config. NULL for FOOTBALL /
  // PICKLEBALL configs and other future sports — callers may
  // treat NULL as BOX_CRICKET when computing pricing / coupon /
  // analytics fan-outs.
  category BookingCategory?

  // Length of a single slot for this court. Always 60 for the
  // existing hour-granular sports; the bowling-machine config is
  // seeded as 30 so its slot picker, pricing and availability grid
  // all work in half-hour steps. Stored on CourtConfig (rather than
  // Sport) so a future "training" config could be 30 without
  // implying anything about the rest of the sport.
  slotDurationMinutes Int @default(60)

  bookings          Booking[]
  slotHolds         SlotHold[]
  prices            PricingRule[]
  slotBlocks        SlotBlock[]
  waitlistEntries   Waitlist[]
  recurringBookings RecurringBooking[]
  operatingWindows  OperatingWindow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sport, size, position])
}

// Open-hours windows specific to a court config. Lets the bowling-
// machine court declare disjoint operating windows ("5–7am AND
// 12–4pm on weekends") that don't necessarily match the venue-wide
// schedule. Empty list for a config = fall back to the legacy
// venue-wide OPERATING_HOURS constant (5am–1am).
//
// `startMinute` / `endMinute` are stored alongside the hour so a
// window can begin/end at :30 — needed for the half-hour bowling
// flow. `endMinute` is exclusive: 16:00 means the last bookable
// 30-min slot starts at 15:30.
model OperatingWindow {
  id            String      @id @default(cuid())
  courtConfigId String
  courtConfig   CourtConfig @relation(fields: [courtConfigId], references: [id], onDelete: Cascade)

  dayType     DayType
  startHour   Int
  startMinute Int     @default(0)
  endHour     Int
  endMinute   Int     @default(0)

  // For display ordering inside the admin editor when multiple
  // disjoint windows are configured for the same day-type.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courtConfigId, dayType])
}

// Transient slot reservation during checkout (5 min TTL, extended during payment).
// Created when user proceeds from slot-selection to checkout.
// Deleted atomically when user commits to a payment (online success OR UPI "I've paid").
// If user abandons checkout, the hold just expires — no Booking is ever created.
model SlotHold {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  courtConfigId String
  courtConfig   CourtConfig @relation(fields: [courtConfigId], references: [id])
  date          DateTime    @db.Date
  hours         Int[]
  // Parallel array to `hours` — startMinutes[i] is the minute
  // offset (0 or 30) of the slot whose hour lives at hours[i].
  // Stored as a separate column rather than packed into `hours`
  // so existing Int[] consumers keep working unchanged: for any
  // pre-bowling hold this column is empty and code treats every
  // entry as starting at :00. Bowling-machine holds always fill
  // it. Same length as `hours` when populated.
  startMinutes  Int[]       @default([])
  // [{ hour: number, minute?: number, price: number }, ...] — the
  // optional `minute` defaults to 0 when missing, keeping legacy
  // payloads valid while letting bowling-machine slot prices be
  // disambiguated for the :30 slot inside the same hour.
  slotPrices    Json
  totalAmount   Int
  expiresAt     DateTime

  // In-flight payment attempt tracking.
  // On payment initiation, expiresAt is extended so the hold survives the
  // payment flow. On success, the hold is deleted and a Booking/Payment is created.
  razorpayOrderId      String?        @unique
  phonePeMerchantTxnId String?        @unique
  paymentMethod        PaymentMethod?
  paymentAmount        Int?
  paymentInitiatedAt   DateTime?

  // Coupon applied during checkout. Persisted on the hold so that when the
  // booking is created (createBookingFromHold) we can record the usage on
  // the Booking row and create a CouponUsage link. None of these are
  // authoritative — they are just a carrier from checkout to booking.
  couponId       String?
  couponCode     String?
  discountAmount Int?

  // Momentum Points redemption applied during checkout. Same carrier
  // pattern as the coupon fields above — populated by
  // applyPointsRedemptionToHold() after previewRedemption() validates
  // the user's pick, then consumed atomically by createBookingFromHold
  // which inserts the REDEEMED_BOOKING ledger row inside the same
  // transaction. Snapshot the paise value so a mid-checkout config
  // change to pointValuePaise doesn't shift what the customer was shown.
  pointsToRedeem         Int?
  pointsRedeemPaiseSaved Int?

  // Equipment rentals the user ticked on the checkout page. Shape:
  // `Array<{ equipmentId: string, name: string, quantity: number,
  // priceEach: number, totalPrice: number }>`. Snapshot of price +
  // name kept here so an admin-side price edit between checkout and
  // commit doesn't change what the customer agreed to. Consumed in
  // createBookingFromHold which creates one EquipmentRental row per
  // entry inside the booking transaction.
  equipmentSelection   Json?
  // Cached SUM of equipmentSelection[].totalPrice in ₹ so payment
  // initiation can include it in the gateway amount without
  // re-parsing the Json. Mirrors hold.discountAmount semantics.
  equipmentTotalAmount Int?

  // Set true when the hold was created through the unified "Half Court
  // (40x90)" customer flow rather than a direct LEFT/RIGHT selection.
  // The hold still points at a concrete LEFT or RIGHT courtConfigId (the
  // system picks a free half at hold-creation time); this flag just tags
  // the booking lineage so downstream customer-facing displays render the
  // neutral "Half Court" label.
  wasBookedAsHalfCourt Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date, expiresAt])
  @@index([userId])
  @@index([courtConfigId, date])
  @@index([expiresAt])
}

model Booking {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  courtConfigId  String
  courtConfig    CourtConfig   @relation(fields: [courtConfigId], references: [id])
  date           DateTime      @db.Date
  status         BookingStatus @default(PENDING)
  totalAmount    Int
  originalAmount Int?
  discountAmount Int           @default(0)
  discountCodeId String?

  // Denormalised from CourtConfig.category at booking time so
  // analytics / reports / coupon validation can filter on
  // "is this a bowling-machine booking?" without a join. NULL for
  // every pre-bowling booking + every non-cricket booking.
  category BookingCategory?

  // Total ₹ added by EquipmentRental rows below (kit, bat, L-guard,
  // …). Denormalised so the booking detail page + reports can show
  // the equipment-portion of totalAmount without re-summing the
  // rentals every render. Always equals SUM(rentals.totalPrice).
  equipmentTotalAmount Int @default(0)

  // Reward bookkeeping moved out — see RewardTransaction (rows tied
  // back to this booking via bookingId).

  createdByAdminId String?
  createdByAdmin   AdminUser? @relation("BookingCreatedByAdmin", fields: [createdByAdminId], references: [id])

  // Origin platform for this booking. "web" for the customer-facing
  // Next.js app (and admin-created bookings), "android" / "ios" for
  // the React Native mobile app. Used for admin analytics + funnel
  // breakdowns. Existing rows backfill to "web" via the migration's
  // column default. Plain String (not enum) so adding new platforms
  // later — e.g. "kiosk" — doesn't require a Prisma enum migration.
  platform String @default("web")

  slots       BookingSlot[]
  payment     Payment?
  editHistory BookingEditHistory[]

  // QR check-in
  checkedInAt DateTime?
  qrToken     String?   @unique @default(cuid())

  // Booking reminders
  reminder24SentAt DateTime?
  reminder2SentAt  DateTime?
  // 1-hour reminder is push-only (no SMS) — fires from the hourly
  // send-reminders cron and lands on the lock screen as a final
  // "see you in an hour" nudge. Existing rows backfill to null,
  // which is the "not yet sent" sentinel the cron logic expects.
  reminder1SentAt  DateTime?

  // New feature relations
  feedback           Feedback?
  equipmentRentals   EquipmentRental[]
  recurringBookingId String?
  recurringBooking   RecurringBooking? @relation(fields: [recurringBookingId], references: [id])

  // True when the customer booked through the unified "Half Court
  // (40x90)" flow (medium, no left/right disclosed). Customer-facing
  // displays (confirmation, invoice, "my bookings") read this flag and
  // show "Half Court (40x90)" instead of the concrete LEFT/RIGHT label.
  // Admin-facing displays always show the concrete label. Bookings made
  // before this flow existed default to false and keep their original
  // label everywhere — we do not backfill.
  wasBookedAsHalfCourt Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courtConfigId, date, status])
  @@index([userId])
  @@index([date, status])
}

model BookingSlot {
  id              String  @id @default(cuid())
  bookingId       String
  booking         Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  startHour       Int
  // 0 or 30 — together with startHour, identifies the actual
  // wall-clock start of this slot. Existing rows backfill to 0
  // via the migration's column default; only bowling-machine
  // bookings ever set 30.
  startMinute     Int     @default(0)
  // 60 for every hour-granular booking; 30 for bowling-machine
  // slots. Lets reports / analytics compute "session minutes"
  // without re-deriving from courtConfig.slotDurationMinutes.
  durationMinutes Int     @default(60)
  price           Int

  @@unique([bookingId, startHour, startMinute])
}

model Payment {
  id        String        @id @default(cuid())
  bookingId String        @unique
  booking   Booking       @relation(fields: [bookingId], references: [id])
  method    PaymentMethod
  status    PaymentStatus @default(PENDING)
  amount    Int

  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?

  // PhonePe payment tracking
  phonePeMerchantTxnId String?
  phonePeTransactionId String?

  // UPI QR payment tracking
  utrNumber      String?
  utrSubmittedAt DateTime?
  utrVerifiedAt  DateTime?
  utrExpiresAt   DateTime?

  isPartialPayment        Boolean        @default(false)
  advanceAmount           Int?
  remainingAmount         Int?
  // For partial payments: the method(s) used to collect the venue-side
  // remainder. `method` above continues to represent how the advance was
  // paid.
  //
  // The remainder can be collected as a split between cash, UPI QR, and
  // an optional on-the-spot discount the floor staff can apply (e.g. a
  // ₹100 goodwill cut for a regular customer). The three amounts sum to
  // the remainder that was owed. `Payment.amount` reflects only what was
  // actually collected — the discounted portion does NOT count as paid.
  //
  // `remainderMethod` is kept as a single-value convenience (set to CASH
  // or UPI_QR when the collection was a single method; left null when the
  // collection was split). Legacy rows that predate split collection have
  // only `remainderMethod` set; the display layer falls back to that when
  // the split fields are null.
  remainderMethod         PaymentMethod?
  remainderCashAmount     Int?
  remainderUpiAmount      Int?
  remainderDiscountAmount Int?

  confirmedBy  String?
  confirmedAt  DateTime?
  refundedBy   String?
  refundedAt   DateTime?
  refundReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, method])
  @@index([utrExpiresAt])
  // Idempotency-check lookups during webhook retries scale with table size.
  // Without these, Razorpay/PhonePe duplicate-webhook handling degrades to
  // full scans as Payment grows.
  @@index([razorpayPaymentId])
  @@index([phonePeMerchantTxnId])
}

model PricingRule {
  id            String      @id @default(cuid())
  courtConfigId String
  courtConfig   CourtConfig @relation(fields: [courtConfigId], references: [id])
  dayType       DayType
  timeType      TimeType
  pricePerSlot  Int

  @@unique([courtConfigId, dayType, timeType])
}

model TimeClassification {
  id        String   @id @default(cuid())
  startHour Int
  endHour   Int
  dayType   DayType
  timeType  TimeType

  @@unique([startHour, dayType])
}

model SlotBlock {
  id            String       @id @default(cuid())
  courtConfigId String?
  courtConfig   CourtConfig? @relation(fields: [courtConfigId], references: [id])
  sport         Sport?
  date          DateTime     @db.Date
  startHour     Int?
  // 0 = block the whole hour (legacy behaviour, preserved by
  // default). 30 = block only the :30 half — used by the
  // bowling-machine flow so admin can block a single 30-min slot
  // without dimming the entire hour for the hour-granular sports.
  startMinute   Int          @default(0)
  reason        String?
  blockedBy     String

  createdAt DateTime @default(now())

  @@index([date, courtConfigId])
  @@index([date, sport])
}

model Notification {
  id        String    @id @default(cuid())
  bookingId String
  channel   String
  status    String
  sentAt    DateTime?
  error     String?

  createdAt DateTime @default(now())

  @@index([bookingId])
}

model PromoBanner {
  id              String            @id @default(cuid())
  title           String
  description     String
  discountInfo    String?
  imageUrl        String?
  placement       BannerPlacement[]
  razorpayOfferId String?
  isActive        Boolean           @default(true)
  startsAt        DateTime
  endsAt          DateTime
  createdBy       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DiscountCode {
  id               String            @id @default(cuid())
  code             String            @unique
  type             DiscountType
  value            Int
  maxUses          Int?
  usedCount        Int               @default(0)
  maxUsesPerUser   Int               @default(1)
  minBookingAmount Int?
  sportFilter      Sport[]
  // Sub-category exclusions WITHIN a sport (same semantics as
  // Coupon.categoryExclude — kept in lock-step). The system
  // new-user code is migrated with [BOWLING_MACHINE] so welcome
  // discounts never apply to bowling-machine bookings.
  // `@default([])` keeps `prisma db push` from creating a NOT-NULL
  // column without a default, which broke the staging seed when
  // upserting rows that don't specify the field.
  categoryExclude  BookingCategory[] @default([])
  validFrom        DateTime
  validUntil       DateTime
  isSystemCode     Boolean           @default(false)
  isActive         Boolean           @default(true)
  createdBy        String

  usages DiscountUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DiscountUsage {
  id             String       @id @default(cuid())
  discountCodeId String
  discountCode   DiscountCode @relation(fields: [discountCodeId], references: [id])
  userId         String
  bookingId      String       @unique
  discountAmount Int

  createdAt DateTime @default(now())

  @@unique([discountCodeId, userId, bookingId])
  @@index([userId])
}

model FAQEntry {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  keywords  String[]
  category  String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model AdminUser {
  id                String    @id @default(cuid())
  username          String    @unique
  email             String    @unique
  passwordHash      String
  role              AdminRole @default(ADMIN)
  permissions       String[]
  isDeletable       Boolean   @default(true)
  inviteToken       String?   @unique
  inviteTokenExpiry DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  createdBookings   Booking[]         @relation("BookingCreatedByAdmin")
  createdCafeOrders CafeOrder[]       @relation("CafeOrderCreatedByAdmin")
  pushDevices       AdminPushDevice[]
  // Async report jobs (sales / Razorpay recon) the admin queued.
  // Cron worker drains the queue and stores the generated bytes
  // back on each row. See /admin/reports + lib/reports/.
  requestedReports  Report[]          @relation("ReportRequestedBy")
}

model BookingEditHistory {
  id            String  @id @default(cuid())
  bookingId     String
  booking       Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  adminId       String
  adminUsername String
  editType      String // CREATED | SLOTS_CHANGED | DATE_CHANGED | COURT_CHANGED

  previousDate          DateTime? @db.Date
  newDate               DateTime? @db.Date
  previousSlots         Int[]
  newSlots              Int[]
  previousCourtConfigId String?
  newCourtConfigId      String?
  previousAmount        Int?
  newAmount             Int?

  note      String?
  createdAt DateTime @default(now())

  @@index([bookingId])
}

// ===========================
// CAFE ORDERING SYSTEM
// ===========================

enum CafeOrderStatus {
  // Payment-first online flow. Order created at checkout but
  // invisible to admin tabs + stock NOT yet decremented until the
  // gateway confirms. Either flips to PENDING/COMPLETED on payment
  // verify, or to CANCELLED on dismiss / failure / timeout. Mirrors
  // the SlotHold → Booking pattern on the sports-booking side.
  PENDING_PAYMENT
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum CafeItemCategory {
  SNACKS
  BEVERAGES
  MEALS
  DESSERTS
  COMBOS
}

model CafeItem {
  id          String           @id @default(cuid())
  name        String
  description String?
  category    CafeItemCategory
  // Selling price, in RUPEES (with optional decimal — e.g. 99.50).
  // Stored as Float so menu pricing can be sub-rupee accurate;
  // payment-gateway boundaries (Razorpay / PhonePe) multiply by
  // 100 to convert to paise on the wire. `formatPrice(price)`
  // renders directly without a /100 divide.
  price       Float
  // Cost price (rupees, optional decimal). What it costs the
  // venue to source/prepare the item; subtracting this from
  // `price` gives the margin per unit, which the cafe-revenue
  // reports use to compute profit. Nullable so existing rows
  // aren't forced to backfill — the reporting path falls back
  // to "unknown margin" when null.
  costPrice   Float?
  // Optional stock count. NULL means the item is unlimited /
  // kitchen-prepared (cooked-to-order — sandwiches, hot meals
  // etc. never run out unless raw ingredients do, and ingredient
  // tracking is out of scope). Non-null means "we have N units
  // on hand"; the customer + admin order paths decrement on
  // order create and refuse the order when stock would go
  // negative. Floor staff resets / restocks this whenever they
  // physically procure goods (drinks, ice-cream, packaged
  // snacks).
  quantity    Int?
  image       String?
  isVeg       Boolean          @default(true)
  isAvailable Boolean          @default(true)
  sortOrder   Int              @default(0)
  tags        String[] // "Bestseller", "New", "Spicy", etc.

  orderItems CafeOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, isAvailable])
}

/**
 * Mid-checkout intent for an online (Razorpay / PhonePe) cafe
 * order. Holds the cart + totals + gateway IDs while the customer
 * is in the payment modal. ONLY converts into a CafeOrder when
 * payment verifies — abandoned intents stay here (and a sweeper
 * deletes them past `expiresAt`) so the CafeOrder table never
 * carries phantom cancelled rows.
 *
 * Mirrors the SlotHold → Booking pattern on the sports side.
 */
model CafePaymentIntent {
  id                   String        @id @default(cuid())
  userId               String?
  guestName            String?
  guestPhone           String?
  note                 String?
  paymentMethod        PaymentMethod // RAZORPAY or PHONEPE only

  // Snapshot of the cart at intent time. Stored as JSON because the
  // intent never serves a relational query — we materialise it
  // into CafeOrderItem rows at verify time, where the relational
  // model takes over.
  cart                 Json

  // Totals frozen at intent time so the customer is paying the
  // amount they saw. Re-validated at verify time against current
  // CafeItem prices; on mismatch we refuse + refund.
  totalAmount          Float
  originalAmount       Float
  discountAmount       Float         @default(0)
  discountCodeId       String?

  // Gateway references. Stamped after the create-order /
  // initiate-payment call so the verify endpoint can look up the
  // intent from a Razorpay order id / PhonePe merchant txn id.
  razorpayOrderId      String?       @unique
  phonePeMerchantTxnId String?       @unique

  // TTL — past this the sweeper cleans the row up. 30 min matches
  // the upper bound a customer might leave a payment modal open
  // without abandoning.
  expiresAt            DateTime

  // Set when the intent has been materialised into a CafeOrder
  // (verify succeeded). Used for idempotency on duplicate verify
  // callbacks.
  consumedAt           DateTime?
  consumedOrderId      String?       @unique

  createdAt            DateTime      @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model CafeOrder {
  id             String          @id @default(cuid())
  userId         String?
  user           User?           @relation(fields: [userId], references: [id])
  guestName      String?
  guestPhone     String?
  orderNumber    String          @unique
  status         CafeOrderStatus @default(PENDING)
  // Order totals in RUPEES (decimal). See CafeItem.price.
  totalAmount    Float
  originalAmount Float?
  discountAmount Float           @default(0)
  discountCodeId String?
  note           String?
  tableNumber    Int?
  // Reward bookkeeping moved out — see RewardTransaction.

  createdByAdminId String?
  createdByAdmin   AdminUser? @relation("CafeOrderCreatedByAdmin", fields: [createdByAdminId], references: [id])

  items       CafeOrderItem[]
  payment     CafePayment?
  editHistory CafeOrderEditHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([orderNumber])
}

model CafeOrderItem {
  id         String    @id @default(cuid())
  orderId    String
  order      CafeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cafeItemId String
  cafeItem   CafeItem  @relation(fields: [cafeItemId], references: [id])
  itemName   String // snapshot of name at time of order
  quantity   Int
  // Per-unit + line total snapshotted at order time, in RUPEES
  // (Float so decimal-priced items round-trip cleanly). Gateway
  // adapters multiply by 100 at the boundary for Razorpay /
  // PhonePe. See CafeItem.price for the unit decision.
  unitPrice  Float
  totalPrice Float

  @@index([orderId])
}

model CafePayment {
  id      String        @id @default(cuid())
  orderId String        @unique
  order   CafeOrder     @relation(fields: [orderId], references: [id])
  method  PaymentMethod
  status  PaymentStatus @default(PENDING)
  // Captured payment amount in RUPEES (decimal). Gateway boundary
  // does ×100 → paise on the way out to Razorpay / PhonePe.
  amount  Float

  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?

  // PhonePe payment tracking
  phonePeMerchantTxnId String?
  phonePeTransactionId String?

  // UPI QR payment tracking
  utrNumber      String?
  utrSubmittedAt DateTime?
  utrVerifiedAt  DateTime?
  utrExpiresAt   DateTime?

  confirmedBy  String?
  confirmedAt  DateTime?
  refundedBy   String?
  refundedAt   DateTime?
  refundReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Denormalised split breakdown — mirrors the booking-side
  // Payment.remainderCashAmount / Upi / Discount columns. When the
  // order was settled across more than one tender method, these
  // hold the slices and sum to CafePayment.amount. When the
  // payment was a single-method settlement these stay null and
  // the .method field alone tells the whole story.
  //
  // splitDiscountAmount is the goodwill write-off slice — does NOT
  // count toward captured revenue (same semantics as the booking
  // model). splitCashAmount + splitUpiAmount = what the venue
  // actually took in.
  splitCashAmount     Float?
  splitUpiAmount      Float?
  splitDiscountAmount Float?

  @@index([status, method])
  @@index([utrExpiresAt])
  // Same idempotency rationale as Payment — keep cafe webhook lookups fast.
  @@index([razorpayPaymentId])
  @@index([phonePeMerchantTxnId])
}

model CafeDiscount {
  id             String             @id @default(cuid())
  code           String             @unique
  type           DiscountType
  // PERCENTAGE rows store basis points (10000 = 100%). FLAT rows
  // store a rupee amount with optional decimal — Float so a "₹49.50
  // off" coupon round-trips cleanly. Migration distinguishes the
  // two types via a conditional /100 update on FLAT rows only.
  value          Float
  maxUses        Int?
  usedCount      Int                @default(0)
  maxUsesPerUser Int                @default(1)
  // Minimum order in RUPEES (decimal). Lined up with
  // CafeOrder.totalAmount's new Float-rupee unit.
  minOrderAmount Float?
  categoryFilter CafeItemCategory[]
  validFrom      DateTime
  validUntil     DateTime
  isActive       Boolean            @default(true)
  createdBy      String

  usages CafeDiscountUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CafeDiscountUsage {
  id             String       @id @default(cuid())
  discountId     String
  discount       CafeDiscount @relation(fields: [discountId], references: [id])
  userId         String
  orderId        String       @unique
  // Amount the customer saved on this usage, in RUPEES (decimal).
  // Matches CafeOrder.discountAmount's unit.
  discountAmount Float

  createdAt DateTime @default(now())

  @@unique([discountId, userId, orderId])
  @@index([userId])
}

model CafeOrderEditHistory {
  id            String    @id @default(cuid())
  orderId       String
  order         CafeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  adminId       String
  adminUsername String
  editType      String // ITEMS_ADDED | ITEMS_REMOVED | QUANTITY_CHANGED | STATUS_CHANGED | ORDER_CANCELLED | ORDER_CREATED

  previousItems  Json?
  newItems       Json?
  // Order-total snapshots before / after the edit, in RUPEES
  // (decimal). Matches CafeOrder.totalAmount's unit.
  previousAmount Float?
  newAmount      Float?

  note      String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

// ===========================
// UNIFIED COUPON SYSTEM
// ===========================

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  description    String?
  scope          CouponScope  @default(BOTH)
  type           DiscountType
  value          Int // basis points (percentage) or paise (flat)
  maxDiscount    Int? // cap on discount amount in paise (for percentage)
  maxUses        Int? // null = unlimited
  usedCount      Int          @default(0)
  maxUsesPerUser Int          @default(1)
  minAmount      Int? // minimum order/booking amount in WHOLE RUPEES

  // Filters
  sportFilter     Sport[]
  categoryFilter  CafeItemCategory[]
  userGroupFilter UserGroupType[]
  // Sub-category exclusions WITHIN a sport. Used today only to
  // mark a coupon as not-valid-on-bowling-machine bookings without
  // having to exclude all of CRICKET. New-user auto-applied codes
  // are seeded with [BOWLING_MACHINE] so the welcome discount
  // never lands on bowling, while regular cricket bookings stay
  // eligible. `@default([])` matches the migration's NOT NULL
  // DEFAULT '{}' so `prisma db push` doesn't recreate the column
  // without a default.
  categoryExclude BookingCategory[]  @default([])

  // Behavior
  isStackable  Boolean @default(false)
  stackGroup   String?
  isPublic     Boolean @default(true) // visible on customer coupon page
  isSystemCode Boolean @default(false) // auto-applied (new user, referral, etc.)

  validFrom  DateTime
  validUntil DateTime
  isActive   Boolean  @default(true)
  createdBy  String

  conditions CouponCondition[]
  usages     CouponUsage[]

  // Admin-curated targeting (sits alongside the auto-computed
  // userGroupFilter). When either of these is non-empty the coupon
  // is restricted to the listed users / members of the listed
  // groups. Empty on both means no targeting — anyone can use it.
  // The validation rule is OR: directly-listed users, OR group
  // members, OR userGroupFilter matches all qualify.
  eligibleUsers  CouponEligibleUser[]
  eligibleGroups CouponEligibleGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope, isActive])
  @@index([code])
}

model CouponCondition {
  id             String              @id @default(cuid())
  couponId       String
  coupon         Coupon              @relation(fields: [couponId], references: [id], onDelete: Cascade)
  conditionType  CouponConditionType
  conditionValue String // JSON-encoded value

  @@index([couponId])
}

model CouponUsage {
  id             String  @id @default(cuid())
  couponId       String
  coupon         Coupon  @relation(fields: [couponId], references: [id])
  userId         String
  bookingId      String?
  cafeOrderId    String?
  discountAmount Int

  createdAt DateTime @default(now())

  @@unique([couponId, userId, bookingId])
  @@index([userId])
  @@index([couponId])
}

// ===========================
// ADMIN-CURATED USER GROUPS
// ===========================
// Custom cohorts an admin builds by hand (vs the auto-computed
// UserGroupType buckets like FIRST_TIME / PREMIUM_PLAYER). These
// power coupon targeting: a coupon can be restricted to specific
// users (CouponEligibleUser) or to members of specific groups
// (CouponEligibleGroup).

model UserGroup {
  id          String  @id @default(cuid())
  name        String
  description String?

  // Soft-delete so coupons referencing the group keep working until
  // the admin explicitly cleans them up. `members` and `coupons` are
  // both Cascade-deleted on hard delete (rare; mostly for tests).
  deletedAt DateTime?
  createdBy String? // admin userId — nullable so seed data is fine
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  members UserGroupMember[]
  coupons CouponEligibleGroup[]

  @@index([deletedAt])
}

model UserGroupMember {
  id      String   @id @default(cuid())
  groupId String
  userId  String
  addedAt DateTime @default(now())

  group UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model CouponEligibleUser {
  id       String   @id @default(cuid())
  couponId String
  userId   String
  addedAt  DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@index([userId])
}

model CouponEligibleGroup {
  id       String   @id @default(cuid())
  couponId String
  groupId  String
  addedAt  DateTime @default(now())

  coupon Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  group  UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([couponId, groupId])
  @@index([groupId])
}

// ===========================
// REWARD POINTS SYSTEM
// ===========================

// Singleton — every admin-tunable rewards knob. Default id is
// "singleton" so seed/upsert code can address the single row by
// stable key without a separate lookup.
model RewardConfig {
  id String @id @default("singleton")

  // Earn rates as basis points per ₹1 of bill. 200 bps = 2% earn.
  // 1 point is worth (pointValuePaise / 100) ₹.
  earnRateBookingBps Int @default(200)
  earnRateCafeBps    Int @default(500)
  // 1 point = pointValuePaise / 100 rupees. 100 = 1 point worth ₹1.
  pointValuePaise    Int @default(100)

  // Redemption guard rails
  minPointsToRedeem        Int @default(50)
  // Float so admins can express finer caps (e.g. 2.5%) without
  // bumping the column to basis points everywhere. Math at the
  // redemption site is `Math.floor(billPaise * pct / 100)` — works
  // for both ints and floats.
  maxRedemptionPctOfBill   Float @default(20) // % cap
  maxRedemptionPaisePerTxn Int @default(50000) // ₹500 absolute cap

  // Expiry — points are EARNED with expiresAt = now() + this window.
  // LIFO consumption (oldest first) keeps the math simple.
  pointExpiryMonths Int @default(12)

  // Anti-abuse hold: points earned within this many hours can't be
  // redeemed yet. Catches the "book micro-slot → earn → redeem on
  // next big booking in same hour" cycle.
  earnToRedeemMinHours Int @default(24)

  // Bonuses (defaults 0 — admin distributes manually via the
  // /admin/rewards/distribute bulk-grant flow instead of via an
  // automatic signup hook). Birthday + referral kept as auto.
  signupBonusPoints      Int @default(0)
  referralEarnerPoints   Int @default(0)
  referralReferredPoints Int @default(0)
  birthdayBonusPoints    Int @default(0)

  // Alert thresholds
  highVelocityEarnDailyThreshold Int @default(5000)
  bulkRedemptionPaiseThreshold   Int @default(50000) // ₹500

  // Kill switches
  enabled         Boolean @default(true)
  cafeEarnEnabled Boolean @default(true)
  // Empty list = all sports earn. Otherwise restrict to the listed
  // ones (e.g. cricket-only earn for a campaign).
  enabledSports   Sport[]

  updatedAt DateTime @updatedAt
}

// Materialized per-user balance. Kept in sync with the transaction
// ledger via the server engine — never edit this row directly,
// always go through a RewardTransaction write.
model RewardBalance {
  userId                 String    @id
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pointsAvailable        Int       @default(0)
  pointsLifetimeEarned   Int       @default(0)
  pointsLifetimeRedeemed Int       @default(0)
  pointsLifetimeExpired  Int       @default(0)
  pointsLifetimeRevoked  Int       @default(0)
  lastTransactionAt      DateTime?

  @@index([pointsAvailable])
}

// Immutable audit log. Every points movement creates a row.
// Balance updates happen in the same transaction as the ledger
// insert so the materialized balance can never diverge from
// SUM(points) for a user.
model RewardTransaction {
  id               String        @id @default(cuid())
  type             RewardTxnType
  // Signed integer: positive for credit (earn / refund), negative
  // for debit (redeem / expired / revoked / adjust-debit).
  points           Int
  // Snapshot of the ₹ value of these points at txn time so the
  // ledger can be exported without re-computing against the
  // current pointValuePaise (which the admin may change later).
  pointsValuePaise Int

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Source FK — exactly one of these is non-null per row, depending
  // on the type:
  //   EARNED_BOOKING / REDEEMED_BOOKING / REVOKED → bookingId
  //   EARNED_CAFE / REDEEMED_CAFE                → cafeOrderId
  //   EARNED_SIGNUP / BIRTHDAY / REFERRAL /
  //   ADJUSTMENT_* / EXPIRED                     → both null
  bookingId   String?
  cafeOrderId String?

  // FIFO accounting for debits — REDEEMED / EXPIRED / REVOKED rows
  // point at the EARNED row they consumed. Lets liability reports
  // answer "did Nakul's expired points come from his Jan booking
  // or his April booking?".
  sourceTxnId String?
  sourceTxn   RewardTransaction?  @relation("RewardTxnConsumedFrom", fields: [sourceTxnId], references: [id], onDelete: SetNull)
  consumers   RewardTransaction[] @relation("RewardTxnConsumedFrom")

  // Set on EARNED rows; null on others. Drives the expiry cron.
  expiresAt DateTime?

  // Free text — required for ADJUSTMENT_* rows for audit trail.
  reason       String?
  actorAdminId String?

  // Idempotency keys — partial unique indexes via @@unique below.
  // Lets us safely retry awardBookingPoints(bookingId) without
  // double-crediting.

  createdAt DateTime @default(now())

  // Idempotency: a given booking can only have one EARNED_BOOKING
  // and one REDEEMED_BOOKING and one REVOKED row. NULL bookingId
  // is allowed multiple times (Postgres unique-with-null semantics).
  @@unique([type, bookingId])
  @@unique([type, cafeOrderId])
  @@index([userId, createdAt])
  @@index([userId, type])
  @@index([expiresAt])
  @@index([bookingId])
  @@index([cafeOrderId])
}

// Fraud / misuse flags. Generated by the hourly alert cron + by
// inline guards inside the server engine (e.g. on revoke shortfall).
model RewardAlert {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       RewardAlertKind
  severity   RewardAlertSeverity
  status     RewardAlertStatus   @default(OPEN)
  // Raw signal data (e.g. points/threshold ratio, related txn ids).
  details    Json
  // Resolution audit
  resolvedBy String?
  resolvedAt DateTime?
  resolution String?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([userId, status])
  @@index([kind, status])
}

// ===========================
// CAFE SETTINGS
// ===========================

/**
 * Singleton settings for the arena's operating hours. Replaces
 * the previously-hardcoded `OPERATING_HOURS = { start: 5, end: 25 }`
 * in lib/court-config.ts. `openHour` is the first bookable hour
 * (inclusive, 0..23); `closeHour` is the exclusive end (1..25 —
 * 25 representing the slot starting at midnight, ending 1am next
 * day, matching the existing convention).
 *
 * Read by every customer slot picker + admin calendar + pricing
 * generator. Edited from /admin/pricing.
 */
model ArenaSettings {
  id        String   @id @default(cuid())
  openHour  Int      @default(5)
  closeHour Int      @default(25)
  updatedAt DateTime @updatedAt
}

model CafeSettings {
  id          String  @id @default(cuid())
  totalTables Int     @default(10)
  // Master open/closed switch. true → customer-facing /cafe + the
  // mobile Cafe tab show the menu + ordering flow. false → both
  // surfaces render the "Cafe is closed" page; admin can keep
  // creating walk-in orders from the admin side regardless.
  isOpen      Boolean @default(true)

  updatedAt DateTime @updatedAt
}

// ===========================
// QR CHECK-IN
// ===========================

// checkedInAt + qrToken added to Booking model via migration

// ===========================
// POST-MATCH FEEDBACK
// ===========================

model Feedback {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  rating    Int // 1-5
  comment   String?
  tags      String[] // e.g. ["great_court", "clean", "staff_friendly"]
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([rating])
}

// ===========================
// WAITLIST
// ===========================

enum WaitlistStatus {
  WAITING
  NOTIFIED
  BOOKED
  EXPIRED
  CANCELLED
}

model Waitlist {
  id            String         @id @default(cuid())
  userId        String?
  user          User?          @relation(fields: [userId], references: [id])
  guestPhone    String?
  guestEmail    String?
  courtConfigId String
  courtConfig   CourtConfig    @relation(fields: [courtConfigId], references: [id])
  date          DateTime
  startHour     Int
  endHour       Int
  status        WaitlistStatus @default(WAITING)
  notifiedAt    DateTime?
  expiresAt     DateTime
  createdAt     DateTime       @default(now())

  @@index([userId])
  @@index([courtConfigId, date, status])
}

// ===========================
// EQUIPMENT RENTAL
// ===========================

model Equipment {
  id                   String            @id @default(cuid())
  name                 String
  sport                Sport?
  // Narrows applicability inside CRICKET. NULL = available for
  // every cricket booking type; BOWLING_MACHINE = only shown in
  // the bowling-machine checkout (kit, bat, L-guard etc).
  category             BookingCategory?
  // Rental price in PAISE for the FULL booking, regardless of
  // duration. Renamed in code as `pricePerBooking` — the column
  // keeps its historical name so existing data and the related
  // EquipmentRental.totalPrice math (which already treats this
  // field as a per-booking flat fee) stay unchanged.
  pricePerHour         Int
  totalUnits           Int               @default(1)
  availableUnits       Int               @default(1)
  isActive             Boolean           @default(true)
  imageUrl             String?
  // Surfaces the item in the customer-facing checkout (web +
  // mobile). Items that exist only as admin-managed bookkeeping
  // — e.g. one-off venue extras — can be hidden by flipping this
  // false without deleting the row.
  isCustomerSelectable Boolean           @default(true)
  // Sort key within the checkout list. Lower = closer to the top.
  // Admin reorders via /admin/equipment.
  displayOrder         Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  rentals              EquipmentRental[]
}

model EquipmentRental {
  id          String    @id @default(cuid())
  bookingId   String
  booking     Booking   @relation(fields: [bookingId], references: [id])
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  quantity    Int       @default(1)
  totalPrice  Int // paise
  createdAt   DateTime  @default(now())

  @@index([bookingId])
  @@index([equipmentId])
}

// ===========================
// RECURRING BOOKINGS
// ===========================

model RecurringConfig {
  id String @id @default(cuid())

  // Weekly discount tiers stored as JSON: [{ weeks: 4, discountPercent: 5 }, { weeks: 8, discountPercent: 10 }, ...]
  // Sorted by weeks ascending
  tiers Json @default("[]")

  // Allowed recurring days (0=Sun … 6=Sat). Empty = all days allowed
  allowedDays Json @default("[0,1,2,3,4,5,6]")

  // Max weeks a customer can book recurring
  maxWeeks Int @default(12)

  // Min weeks to qualify for recurring
  minWeeks Int @default(2)

  // Daily recurring discount tiers: [{ days: 5, discountPercent: 3 }, { days: 10, discountPercent: 7 }, ...]
  dailyTiers Json @default("[]")

  // Max consecutive days allowed for daily recurring
  maxDays Int @default(30)

  // Min days for daily recurring
  minDays Int @default(2)

  // Whether recurring bookings are enabled
  enabled Boolean @default(true)

  updatedAt DateTime @updatedAt
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
}

model RecurringBooking {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  courtConfigId String
  courtConfig   CourtConfig     @relation(fields: [courtConfigId], references: [id])
  startHour     Int
  // 0 by default — the bowling-machine recurring flow uses 30 so a
  // weekly 9:30–10:00 session can recur correctly. Both `startHour`
  // and `endHour` get a paired `*Minute` to disambiguate.
  startMinute   Int             @default(0)
  endHour       Int
  endMinute     Int             @default(0)
  dayOfWeek     Int // 0=Sun … 6=Sat
  startDate     DateTime
  endDate       DateTime? // null = indefinite (max 3 months enforced in code)
  mode          String          @default("weekly") // "weekly" or "daily"
  status        RecurringStatus @default(ACTIVE)
  bookings      Booking[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId])
  @@index([status])
}

// ===========================
// GENERATOR MANAGEMENT
// ===========================

model Generator {
  id       String  @id // manually assigned e.g. "xgen_2026"
  name     String // e.g. "Generator 1"
  isActive Boolean @default(true)

  fuelLogs   GeneratorFuelLog[]
  oilChanges GeneratorOilChange[]
  runLogs    GeneratorRunLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GeneratorConfig {
  id String @id @default(cuid())

  petrolPricePerLitre Int   @default(9500) // paise — ₹95
  oilPricePerLitre    Int   @default(29500) // paise — ₹295
  consumptionRate     Float @default(2.0) // litres per hour

  // Oil change schedule (in running hours)
  firstOilChangeHours   Int @default(20)
  secondOilChangeHours  Int @default(50) // interval after first
  regularOilChangeHours Int @default(100) // interval after second, repeating

  // Alert threshold
  oilChangeAlertHours Int @default(10) // send email when X hrs remain

  // Notification emails (comma-separated)
  notificationEmails String @default("y12.nakul@gmail.com,tangrianand@gmail.com,saxenautkarsh193@gmail.com,momentumarena2026@gmail.com")

  // MSG91 template IDs
  oilChangeTemplateId String @default("Oil_Change_Reminder")
  monthlyTemplateId   String @default("Generator_Monthly_Summary")
  pinChangeTemplateId String @default("generator_pin_change")

  // Mobile access PIN (6-digit)
  generatorPin String @default("987065")

  // Hardware API key for bulk log endpoint
  hardwareApiKey String @default("ma-gen-hw-2026-secret")

  updatedAt DateTime @updatedAt
}

model GeneratorFuelLog {
  id          String    @id @default(cuid())
  generatorId String
  generator   Generator @relation(fields: [generatorId], references: [id])

  date          DateTime @db.Date
  litres        Float // litres filled
  pricePerLitre Int // paise at time of fill
  totalCost     Int // paise (litres * pricePerLitre)

  // Fuel stock tracking
  isStockPurchase Boolean @default(false) // true = bought fuel into stock, false = filled into generator

  notes     String?
  createdAt DateTime @default(now())

  @@index([generatorId])
  @@index([date])
}

model GeneratorOilChange {
  id          String    @id @default(cuid())
  generatorId String
  generator   Generator @relation(fields: [generatorId], references: [id])

  date                 DateTime @db.Date
  runningHoursAtChange Float // total running hours when oil was changed
  litres               Float    @default(1) // oil quantity used
  costPerLitre         Int // paise at time of change
  totalCost            Int // paise
  notes                String?

  // Which change in sequence (1st, 2nd, 3rd...)
  sequenceNumber Int

  createdAt DateTime @default(now())

  @@index([generatorId])
  @@index([date])
}

// Optional: manual start/stop logging for accurate runtime tracking
model GeneratorRunLog {
  id          String    @id @default(cuid())
  generatorId String
  generator   Generator @relation(fields: [generatorId], references: [id])

  entryId Int? // sequential ID from device or auto-generated
  source  String @default("website") // "website" or "hardware"

  startTime     DateTime
  endTime       DateTime?
  durationHours Float? // calculated from start/end, or manually entered
  notes         String?

  createdAt DateTime @default(now())

  @@index([generatorId])
  @@index([startTime])
}

// ===========================
// CACHED DOCUMENTS (PDFs regenerated on a schedule, served at a public URL)
// ===========================

model CachedDocument {
  // String id so the set is extensible (SPORTS_PRICING, CAFE_MENU, ...)
  // without schema churn as new documents are added.
  id          String   @id
  content     Bytes
  mimeType    String   @default("application/pdf")
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===========================
// EXPENSES
// Internal cost tracker, modelled after the Playing Zone Mathura spend
// sheet. Replaces the Google Sheet the founders were maintaining by
// hand. Every dropdown on the UI is sourced from ExpenseOption, so
// admins can add / rename / disable categories without a redeploy.
// Amount is stored as whole rupees (Int) — same convention as
// Booking.totalAmount — not paise.
// ===========================

model Expense {
  id          String   @id @default(cuid())
  // Calendar date of the expense (what would be typed into the sheet),
  // independent of createdAt which tracks row entry time.
  date        DateTime @db.Date
  description String
  amount      Int
  // Foreign-key-lite references to ExpenseOption.label: we store the
  // label string rather than an ID so that renaming an option (or
  // hiding it) doesn't orphan historical rows, and a quick text export
  // still shows human-readable values. Filtering joins on label.
  paymentType String // e.g. "Cash" / "Online" — the old "Type" column
  doneBy      String // e.g. "Nakul" / "Utkarsh" / "Anand"
  toName      String // immediate recipient (shop / labour / driver…)
  vendor      String // money-attributed bucket ("Self" / "Landlord" / "SDA")
  spentType   String // category ("Turf" / "Rent" / "Paint"…)
  note        String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdByAdminId String?

  editHistory ExpenseEditHistory[]

  @@index([date])
  @@index([spentType])
  @@index([doneBy])
  @@index([vendor])
  @@index([paymentType])
}

// Audit trail for expense rows. One entry is written on CREATED, and
// another on every edit. `changes` is a JSON array of
// { field, from, to } triples so we don't need a dedicated column per
// mutable field — cheaper to extend when new Expense columns appear.
// adminId + adminUsername are denormalized so the log stays readable
// even if the AdminUser row is later deleted. adminId/username are
// nullable because CSV imports happen without a specific admin actor.
model ExpenseEditHistory {
  id            String   @id @default(cuid())
  expenseId     String
  expense       Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  adminId       String?
  adminUsername String?
  editType      String // CREATED | UPDATED
  changes       Json
  note          String?
  createdAt     DateTime @default(now())

  @@index([expenseId])
  @@index([createdAt])
}

// Which dropdown a given option feeds. Order matches the UI tabs on
// the expense config page so it's easy to reason about.
enum ExpenseOptionField {
  PAYMENT_TYPE
  DONE_BY
  VENDOR
  SPENT_TYPE
  TO_NAME
}

model ExpenseOption {
  id        String             @id @default(cuid())
  field     ExpenseOptionField
  // Displayed + stored form of the option (e.g. "Cash"). Uniqueness
  // scoped to field so "Cash" for PAYMENT_TYPE doesn't collide with
  // the same label in a different field. Disabling (isActive=false)
  // hides the option from new-expense dropdowns but keeps historical
  // rows intact since Expense.* columns store the raw label.
  label     String
  isActive  Boolean            @default(true)
  sortOrder Int                @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([field, label])
  @@index([field, isActive])
}

// ===========================
// PUSH NOTIFICATIONS (FCM)
// ===========================
// One row per signed-in mobile device. The mobile app posts its FCM
// token after login (and on token rotation), then we use these rows
// to fan-out push payloads via Firebase Admin SDK from the existing
// notification triggers (booking confirmation, 24h/2h reminders, UPI
// verified, refund processed, etc.).
//
// `token` is unique because FCM tokens are globally unique to an
// install. When a user signs out, the row is deleted. When FCM
// returns `messaging/registration-token-not-registered` on send, the
// dead row is also deleted (background cleanup; see lib/push.ts).

model PushDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  // "ios" | "android" — used to keep platform-specific debugging and
  // future per-platform throttling straightforward without a Prisma
  // enum migration on every new value (e.g. "web-push" later).
  platform   String
  appVersion String?
  // Bumped on every successful POST /api/mobile/devices so token-
  // pruning crons can drop devices that haven't checked in in a long
  // time (signaling app uninstall / sign-out from another device).
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([lastSeenAt])
}

/// FCM token registry for admin devices. Separate from PushDevice
/// because admins log in through AdminUser (not User), and we want
/// fan-outs to either group to be a single SQL query without
/// nullable foreign keys or a discriminator column.
///
/// A single physical device can hold rows in BOTH tables — a staffer
/// who's signed in as both customer and admin will get customer
/// pushes for their own bookings AND admin pushes for the floor's
/// queue. The unique `token` constraint is global; an FCM token only
/// ever lives in one row per table at a time, but can exist in both.
///
/// Dead-token cleanup in lib/push.ts removes from both tables when
/// FCM reports the token is no longer registered.
model AdminPushDevice {
  id         String    @id @default(cuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  token      String    @unique
  platform   String
  appVersion String?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([adminId])
  @@index([lastSeenAt])
}

// ===========================
// FIRST-PARTY ANALYTICS
// ===========================
// Self-hosted CTA tracking + funnel + cohort + retention dashboard.
// Schema designed to be queried directly for ad-hoc lookups AND
// rolled up hourly/daily into MetricRollup for fast dashboards.
//
// Naming: `AnalyticsEvent` and `AnalyticsSession` (not just `Event`
// and `Session`) so we don't collide with NextAuth's existing
// `Session` model and to make the analytics origin obvious in code.

enum AnalyticsCategory {
  BOOKING // sport_selected, slot_toggled, proceed_to_checkout, ...
  PAYMENT // payment_initiated, payment_completed, payment_failed, ...
  AUTH // login_modal_opened, otp_submitted, login_success, ...
  CAFE // cafe_browse, item_added, cafe_payment_completed, ...
  WAITLIST // slot_unavailable_tap, waitlist_joined, ...
  REWARDS // rewards_view, rewards_redeem_started, rewards_redeem_completed
  NAVIGATION // page_view, tab_switched, deep_link_opened
  ADMIN // admin_login, admin_action_*
  ERROR // client_error, payment_error, push_subscribe_failed
  SYSTEM // session_started, session_ended, app_foreground
}

model AnalyticsSession {
  id          String    @id @default(cuid())
  userId      String? // null while anonymous; populated on first auth event
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  platform    String // "web" | "android" | "ios"
  // First-touch attribution. Captured from the URL on the first
  // page view of the session and frozen — these don't change even
  // if the user navigates around.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  // First-page context (web only). Useful for landing-page A/B and
  // referral-source analysis. Mobile leaves these null.
  landingPath String?
  referrer    String?
  // Lightweight UA parse (web). NEVER store raw UA — too much PII +
  // pointless noise. Mobile captures appVersion + osVersion instead.
  uaBrowser   String? // e.g. "Chrome", "Safari"
  uaOs        String? // e.g. "iOS", "macOS", "Windows"
  uaDevice    String? // e.g. "mobile", "desktop", "tablet"
  appVersion  String? // mobile-only
  startedAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  // Backfilled once the session ends (>30min idle on web, app-
  // background on mobile). Lets us aggregate session length without
  // recomputing from the events table.
  endedAt     DateTime?

  events AnalyticsEvent[]

  @@index([userId])
  @@index([startedAt])
  @@index([userId, startedAt])
}

model AnalyticsEvent {
  id         String            @id @default(cuid())
  // Stable machine name — keep these snake_case and grep-able.
  // Existing trackXxx() helpers in lib/analytics.ts produce names
  // like "slot_toggled", "proceed_to_checkout_click", etc.; mobile
  // mirrors the same names so funnels are platform-agnostic.
  name       String
  category   AnalyticsCategory
  // Optional FK to User. Anonymous events leave this null and
  // backfill it later via AnalyticsSession.userId once the user
  // signs in. The session FK is the join key for that backfill.
  userId     String?
  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId  String
  session    AnalyticsSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  platform   String // "web" | "android" | "ios"
  // Free-form structured payload. Per-event keys differ — keep the
  // SCHEMA documented in lib/analytics.ts (the trackXxx helper that
  // produces the event is the source of truth for what keys land
  // here). Logged user PII (name, phone) lives under `properties.user`.
  properties Json
  pageUrl    String? // web only — exact URL when event fired
  occurredAt DateTime          @default(now())

  @@index([name, occurredAt])
  @@index([sessionId, occurredAt])
  @@index([userId, occurredAt])
  // BRIN-friendly time-only index for the daily retention cron and
  // for the rollup writer's "events since last bucket" scan.
  @@index([occurredAt])
  @@index([category, occurredAt])
}

// Server-side audit trail — one row per meaningful API / server-action
// outcome. Separate from AnalyticsEvent so product funnels aren't
// polluted and we can store path/method/outcome without a session FK.
model ServerActionLog {
  id         String            @id @default(cuid())
  userId     String?
  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Dotted machine name — e.g. "booking.lock", "booking.apply_coupon".
  action     String
  category   AnalyticsCategory
  outcome    String // "success" | "error"
  path       String?
  method     String?
  platform   String // "web" | "android" | "ios"
  metadata   Json              @default("{}")
  error      String?
  occurredAt DateTime          @default(now())

  @@index([userId, occurredAt])
  @@index([action, occurredAt])
  @@index([occurredAt])
  @@index([category, occurredAt])
}

// Pre-aggregated counters keyed by (bucket, metric, dimensions).
// Written by an hourly cron — see /api/cron/rollup-metrics. Lets
// the dashboard render 90-day trends with a single indexed scan
// instead of a Big GROUP BY over every Event row.
model MetricRollup {
  id          String   @id @default(cuid())
  // Hour-aligned (or day-aligned, see bucketKind). Always UTC.
  bucketStart DateTime
  bucketKind  String // "hour" | "day"
  // Dotted name. e.g. "funnel.booking.proceed_to_checkout",
  // "kpi.bookings_confirmed", "waitlist.notified".
  metric      String
  // Group-by keys for slicing in the dashboard. Common keys:
  // { sport, platform, courtConfigId, paymentMethod }. Empty
  // object {} means "global / no slicing".
  dimensions  Json
  count       Int      @default(0)
  // Optional aggregate (e.g. revenue sum for booking_confirmed).
  // Null for pure count metrics.
  sumValue    Float?
  // Optional unique-cardinality (e.g. distinct users who hit step).
  // Null for non-uniqueness metrics.
  uniqueCount Int?

  // (bucketStart + bucketKind + metric + dimensions) is the natural
  // key. We hash dimensions to a sorted JSON string for the unique
  // index because Prisma can't unique-index Json directly.
  dimensionsKey String

  @@unique([bucketStart, bucketKind, metric, dimensionsKey])
  @@index([metric, bucketStart])
  @@index([bucketStart])
}

// Cohort assignment per user. Built once per user at first event
// (cohortStart = first session's calendar week, IST). Lets us run
// classic week-on-week retention queries in O(N) without window
// functions. Updated only when the cohort assignment is missing —
// it's frozen for the lifetime of the user.
model UserCohort {
  userId      String   @id
  user        User     @relation("UserCohortFK", fields: [userId], references: [id], onDelete: Cascade)
  // ISO week start in IST (Mon 00:00 IST). e.g. 2026-05-04T00:00 IST
  // for the week of 4-10 May 2026.
  cohortWeek  DateTime
  // Same idea, month-aligned (1st of month IST). Useful for the
  // monthly retention grid.
  cohortMonth DateTime
  // First event timestamp — handy for "how long until they did X?".
  firstSeenAt DateTime

  @@index([cohortWeek])
  @@index([cohortMonth])
}

// ===========================
// REPORT QUEUE
// ===========================
// Async monthly report generation. Admin queues a report from
// /admin/reports → cron worker (/api/cron/process-reports) drains
// the queue serially and stores the generated XLSX bytes back on
// the row. Once status flips to READY the admin can download via
// /api/admin/reports/[id]/download.
//
// Bytes are kept inline (Postgres BYTEA) instead of an external
// blob store — files are <100KB and we'd rather not pay for S3/
// Vercel Blob for a low-volume admin feature. Retention cron
// purges READY rows older than 90 days; the row stays (for audit)
// but `fileBytes` is nulled and status flips to EXPIRED.

enum ReportType {
  SALES_MONTHLY // Bookings + cafe revenue, generated from our DB.
  RAZORPAY_RECON_MONTHLY // Settlement reconciliation pulled from Razorpay.
  // Same column shape as SALES_MONTHLY — separate type so the CA's
  // copy of the books is filename-tagged for easy filing
  // ("…_ca-report.xlsx" vs the internal "…_revenue.xlsx").
  CA_MONTHLY
  // All Expense rows for the month + a per-person spend summary
  // so the operations team can see who is spending how much
  // (mapped to Expense.doneBy — the staff member who paid out).
  EXPENSES_MONTHLY
  // Same structure as EXPENSES_MONTHLY but covering every Expense
  // row ever (from day 1). `year` and `month` on the Report row
  // store the request timestamp's month for naming/ordering only —
  // the worker ignores them and pulls everything.
  EXPENSES_LIFETIME
  // Rewards liability snapshot for the calendar month — per-user
  // outstanding balance + lifetime totals + month-bucketed earn /
  // redeem / expire counts. Sheet "By user" + sheet "Summary".
  REWARD_LIABILITY_MONTHLY
  // Same shape as REWARD_LIABILITY_MONTHLY but covers every
  // RewardTransaction since the v2 schema landed. Year/month on the
  // Report row are request-timestamp only.
  REWARD_LIABILITY_LIFETIME
  // Open + resolved RewardAlert rows for the month with full details
  // JSON expanded into columns. Two sheets: "Alerts" + "By kind".
  REWARD_ALERTS_MONTHLY
  // Per-transaction ledger for the calendar month — every earn,
  // redeem, revoke, expire, and admin adjustment as one row.
  // Summary sheet rolls up by type + by IST-month so CAs can
  // reconcile against the sales / Razorpay reports.
  REWARD_TXN_LEDGER_MONTHLY
  // Same per-transaction shape as REWARD_TXN_LEDGER_MONTHLY but
  // covers every RewardTransaction ever recorded. Year/month on
  // the Report row are request-timestamp metadata only.
  REWARD_TXN_LEDGER_LIFETIME
  // Cafe item inventory + sales snapshot for the calendar month.
  // One row per CafeItem: id, name + description, total units
  // sold in the month, cash / online unit splits, current
  // on-hand stock. Replicates the /admin/analytics/cafe inventory
  // table exactly so admins can download what they see.
  CAFE_INVENTORY_MONTHLY
  // Same shape as CAFE_INVENTORY_MONTHLY but no date filter —
  // every cafe order ever. Matches the cafe analytics page's
  // DEFAULT window (earliest order → today), which is what the
  // inventory table shows out of the box. Year/month on the
  // Report row are request-timestamp metadata only.
  CAFE_INVENTORY_LIFETIME
}

enum ReportStatus {
  QUEUED // Sitting in the queue, waiting for the worker.
  GENERATING // Worker has picked it up, currently building the XLSX.
  READY // Done — fileBytes populated, admin can download.
  FAILED // Worker hit an error — see errorMessage.
  EXPIRED // Past retention; bytes nulled but the row's kept for audit.
}

model Report {
  id            String       @id @default(cuid())
  type          ReportType
  status        ReportStatus @default(QUEUED)
  // Period the report covers — both reports are calendar-month-
  // aligned so this is the natural key to dedupe duplicate requests
  // (we don't enforce uniqueness at the DB level — admins might
  // legitimately want a fresh re-pull, e.g. after Razorpay corrects
  // a settlement).
  year          Int
  month         Int
  // Who requested it — drives the "your reports" filter on the page.
  requestedById String
  requestedBy   AdminUser    @relation("ReportRequestedBy", fields: [requestedById], references: [id])
  // Generation lifecycle timestamps.
  startedAt     DateTime?
  completedAt   DateTime?
  // Populated when status flips to FAILED.
  errorMessage  String?
  // Output metadata.
  filename      String?
  fileSizeBytes Int?
  // The generated workbook bytes. Null until the worker writes;
  // re-nulled by the retention cron after 90d.
  fileBytes     Bytes?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Drives the worker's "next job" query — pick the oldest QUEUED
  // row across the whole table.
  @@index([status, createdAt])
  @@index([requestedById, createdAt])
  @@index([type, year, month])
}

// ===========================
// SHOP — sellable products (Phase 9)
// ===========================
// Standalone module for selling items the venue keeps in inventory
// (leather balls, L-guards, etc). Lives entirely separate from the
// existing Equipment-rental flow so the two don't tangle on
// pricing, stock, or order semantics.
//
// Fulfillment is pickup-at-venue only — no shipping, no addresses.
// Stock decrements atomically when an order is placed and is
// restored if the order is cancelled.

enum ProductOrderStatus {
  PENDING // payment committed but not verified (UPI QR / cash)
  CONFIRMED // payment verified — ready for venue pickup
  FULFILLED // customer picked it up at venue
  CANCELLED // order cancelled before fulfillment
  REFUNDED // post-fulfillment refund
}

enum ProductStockMovementReason {
  SALE
  RESTOCK
  ADJUSTMENT // admin-set absolute value
  REFUND
  RELEASE // released back from a cancelled / expired order
}

model ProductCategory {
  id           String    @id @default(cuid())
  name         String
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  products     Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String  @id @default(cuid())
  name        String
  description String?

  // Per-item retail price in PAISE for the FULL item (no per-hour
  // semantics here — Equipment's `pricePerHour` is a hangover; this
  // model starts clean).
  pricePaise Int

  // Optional cost-of-goods in PAISE — what the venue paid for one
  // unit. Used by the analytics tab to compute gross profit
  // (revenue − cost × qty). Defaults to 0 so existing products
  // and tests don't have to be backfilled; admins fill it in via
  // the product edit form when they want margin reporting.
  costPaise Int @default(0)

  // Current inventory count. Decremented atomically on order
  // placement, restored on cancel. Items with stockQuantity <= 0
  // auto-hide from the customer shop unless `allowBackorder` is on
  // (placeholder for v2 — currently always false).
  stockQuantity     Int @default(0)
  // Soft floor for "low stock" UI hint. Doesn't block sale; just
  // surfaces a yellow indicator on the admin product list.
  lowStockThreshold Int @default(3)

  // Vercel Blob URL — uploaded via the admin form, not a free-text
  // input. Null until an image is uploaded; the customer shop falls
  // back to a placeholder.
  imageUrl String?

  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id])

  cartItems      CartItem[]
  orderItems     ProductOrderItem[]
  stockMovements ProductStockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, displayOrder])
  @@index([categoryId])
}

// Persisted per-user cart. Signed-out users hold the cart in
// localStorage and we merge into this on sign-in (createdAt of the
// localStorage line wins for the qty, server line for the price).
model Cart {
  id     String     @id @default(cuid())
  userId String     @unique
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  // Quantity at the time the customer added it. Server re-prices on
  // checkout against the live Product row — the cart is just a
  // basket, not a price contract.
  quantity  Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One row per (cart, product) — adding the same product again
  // bumps the quantity instead of duplicating.
  @@unique([cartId, productId])
  @@index([productId])
}

// One row per checkout. Mirrors the Booking + Payment pattern so the
// existing payment-gateway plumbing can be reused: a ProductOrder
// has a 1-to-1 Payment row of its own (see ProductOrderPayment
// below) and items[] for the line items.
model ProductOrder {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  status     ProductOrderStatus @default(PENDING)
  // Sum of items[].priceEachPaise × qty, in PAISE. Snapshot — not
  // recomputed from live Product rows after the order lands.
  totalPaise Int

  items   ProductOrderItem[]
  payment ProductOrderPayment?

  // Admin who fulfilled the order at the venue (null until pickup).
  fulfilledById String?
  fulfilledAt   DateTime?

  // Walk-in POS orders set this so reports can split "online" vs
  // "at the counter" sales. Null = regular online order.
  createdByAdminId String?

  // Soft order number for receipts / customer comms. Auto-derived
  // from createdAt + a short id slice; populated on insert.
  orderNumber String? @unique

  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model ProductOrderItem {
  id        String       @id @default(cuid())
  orderId   String
  order     ProductOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product      @relation(fields: [productId], references: [id])

  // Snapshots captured at order time so future product edits don't
  // change historical orders.
  nameSnapshot   String
  priceEachPaise Int
  // Cost-of-goods per unit at the time of sale. Frozen here so the
  // analytics view shows historical margin even after the admin
  // updates Product.costPaise. Defaults to 0 for items sold before
  // the cost field existed.
  costEachPaise  Int    @default(0)
  quantity       Int

  @@index([orderId])
  @@index([productId])
}

// Separate from the booking Payment model so the two don't collide
// on bookingId. Same gateway machinery (Razorpay/PhonePe/UPI-QR/Cash)
// can populate either.
model ProductOrderPayment {
  id      String       @id @default(cuid())
  orderId String       @unique
  order   ProductOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method PaymentMethod
  status PaymentStatus @default(PENDING)
  // Total captured in PAISE.
  amount Int

  razorpayOrderId      String?
  razorpayPaymentId    String?
  razorpaySignature    String?
  phonePeMerchantTxnId String?
  phonePeTransactionId String?
  utrNumber            String?

  confirmedAt   DateTime?
  confirmedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([razorpayPaymentId])
  @@index([phonePeMerchantTxnId])
}

// Audit trail of every stock change. Lets admins debug "where did
// my inventory go" without grepping the order table.
model ProductStockMovement {
  id        String                     @id @default(cuid())
  productId String
  product   Product                    @relation(fields: [productId], references: [id])
  // Signed delta — negative for SALE / ADJUSTMENT-down, positive
  // for RESTOCK / RELEASE / REFUND.
  delta     Int
  reason    ProductStockMovementReason
  // FK back to the order that caused the movement, when relevant.
  orderId   String?
  note      String?
  // AdminUser.id when the movement was admin-initiated.
  adminId   String?

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([orderId])
}
