{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "development": true
    }
  },
  "ignoreCommand": "bash scripts/vercel-ignore.sh",
  "crons": [
    {
      "path": "/api/cron/cleanup-locks",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/analytics-retention",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/cohort-backfill",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/reports-retention",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/rewards-expire",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron/rewards-alerts",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron/send-reminders",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/cron/generator-check",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/cron/challenge-money",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/cron/challenge-offers",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/cron/process-reports",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/cron/rollup-metrics",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/cron/store-availability",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/cron/daily-push",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/cron/tournament-reg-drive",
      "schedule": "30 * * * *"
    }
  ]
}
