DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&connect_timeout=30&pool_timeout=30"
AUTH_SECRET="generate-with: npx auth secret"

# MSG91 (Email + SMS OTP)
MSG91_AUTH_KEY=""
# MSG91 verified email SENDING domain (defaults to mail.momentumarena.com).
# A subdomain on purpose: MSG91 verification requires pointing the sending
# domain's MX at mailer91, and doing that on the apex would hijack inbound
# org mail (apex MX -> secureserver.net). From = noreply@<this domain>.
MSG91_EMAIL_DOMAIN=""
MSG91_TEMPLATE_ID=""
MSG91_SMS_TEMPLATE_ID=""
MSG91_BOOKING_CONFIRMATION_TEMPLATE_ID=""
MSG91_ADMIN_PENDING_BOOKING_TEMPLATE_ID=""

# Store-reviewer login bypass (Apple/Google review). When BOTH are set, this one
# 10-digit phone skips the SMS gateway and accepts APPSTORE_TEST_OTP as its code,
# so reviewers can sign in without a real SMS. Set ONLY on the review/dev backend
# — leave unset in production. Unset = no bypass.
APPSTORE_TEST_PHONE=""
APPSTORE_TEST_OTP=""

# Self-hosted OTA (Expo Updates). EXPO_OTA_PRIVATE_KEY signs each update
# manifest (the RSA private key from `expo-updates codesigning:generate`, PEM
# with \n-escaped or real newlines); the matching public cert is embedded in
# the app. BLOB_READ_WRITE_TOKEN is auto-added by the Vercel Blob store and is
# used by scripts/publish-ota.ts to upload bundles. See lib/ota/* + /admin/ota.
EXPO_OTA_PRIVATE_KEY=""
BLOB_READ_WRITE_TOKEN=""

# Admin notification phones (comma-separated with 91 country code)
ADMIN_NOTIFICATION_PHONES="919870437753,919929987404,919027936468"

# Razorpay
# Use rzp_test_* keys for Preview/Development and rzp_live_* in Production.
RAZORPAY_KEY_ID="rzp_test_xxx"
RAZORPAY_KEY_SECRET="xxx"
# HMAC secret for the S2S webhook (Razorpay dashboard → Settings → Webhooks,
# pointing at /api/razorpay/webhook). REQUIRED in production: without it the
# webhook rejects every event, so the captured-but-no-booking recovery path
# (orphaned-payment safety net) silently never fires. See lib/razorpay.ts.
RAZORPAY_WEBHOOK_SECRET=""

# PhonePe Standard Checkout v2 — set per-environment on Vercel
# (sandbox keys for Preview/Development, production keys for
# Production). PHONEPE_ENV controls which API host the SDK targets.
PHONEPE_CLIENT_ID=""
PHONEPE_CLIENT_SECRET=""
PHONEPE_CLIENT_VERSION="1"
PHONEPE_ENV="SANDBOX"  # SANDBOX | PRODUCTION

# PhonePe webhook (S2S callback) auth — configure these in the
# PhonePe dashboard's Webhooks tab; PhonePe sends
# `Authorization: SHA256(username:password)` on every webhook and
# we verify against these env values.
PHONEPE_WEBHOOK_USERNAME=""
PHONEPE_WEBHOOK_PASSWORD=""

# PhonePe Static QR (separate product — venue-side QR codes).
# Still uses the legacy V1 X-VERIFY scheme. Leave unset if you're
# not using static QR webhooks; the route will reject incoming
# callbacks rather than silently accept unverified ones.
PHONEPE_STATIC_QR_SALT_KEY=""
PHONEPE_STATIC_QR_SALT_INDEX="1"

# PhonePe Dynamic QR (DQR) — the offline/enterprise per-transaction QR
# product. Dormant until ALL of MERCHANT_ID + SALT_KEY + STORE_ID are
# set (see lib/phonepe-dqr.ts `isDqrConfigured`) AND an admin enables
# it on /admin/payment-settings. Uses the legacy V1 X-VERIFY scheme.
# See docs/phonepe-dqr-onboarding.md for what to request from PhonePe.
PHONEPE_DQR_MERCHANT_ID=""
PHONEPE_DQR_SALT_KEY=""
PHONEPE_DQR_SALT_INDEX="1"
PHONEPE_DQR_STORE_ID=""      # optional override for DQR CHECKOUT; falls back
                             # to PHONEPE_DQR_STORE_ID_ONLINE below (checkout
                             # QRs generate under the "Online" PhonePe store)
PHONEPE_DQR_TERMINAL_ID=""   # optional — for multi-terminal reporting

# Per-store ids for the admin PhonePe REPORTING dashboard
# (POST /v3/qr/transaction/list is keyed per merchantId + storeId). One
# merchant, five stores — the dashboard renders these as tabs in this order
# (Online first/default, Offline second). Reporting is enabled when
# MERCHANT_ID + SALT_KEY + at least one of these are set — independent of the
# singular STORE_ID above (which only gates checkout).
PHONEPE_DQR_STORE_ID_ONLINE=""
PHONEPE_DQR_STORE_ID_OFFLINE=""
PHONEPE_DQR_STORE_ID_GYM=""
PHONEPE_DQR_STORE_ID_YOGA=""
PHONEPE_DQR_STORE_ID_CAFE=""
# OPTIONAL — only for merchants that have MULTIPLE merchant IDs. Sent as the
# X-PROVIDER-ID header on the transaction-list API. SPORTIVEVENTURES has ONE
# merchant id with multiple stores, so this is left UNSET. (If PhonePe returns
# 500 on the transaction-list API, that's a merchant-side enablement gap for the
# offline reconciliation product — NOT this var; ask PhonePe to provision it.)
PHONEPE_DQR_PROVIDER_ID=""
# DQR host override. Falls back to PHONEPE_ENV, then SANDBOX. Set this to
# PRODUCTION to run DQR against mercury-t2 (prod) while leaving the rest of
# the PhonePe integration on SANDBOX — e.g. testing prod DQR creds on the
# development deploy without pointing the gateway checkout at real money.
PHONEPE_DQR_ENV=""  # ""|SANDBOX|PRODUCTION
# Which UPI product backs the "Pay by UPI" option. Default (unset or "qr") uses
# scan-only Dynamic QR (/v3/qr/init). Set to "intent" once PhonePe enables UPI
# Open Intent acceptance on the VPA — a tappable upi:// link that pays
# same-device in any UPI app (/v1/intent/init). Status + callback are identical.
PHONEPE_DQR_MODE=""  # ""(=qr)|qr|intent

# Cron Secret (for /api/cron/cleanup-locks)
CRON_SECRET="generate-a-random-secret"

# Analytics retention (daily cron at /api/cron/analytics-retention)
ANALYTICS_RAW_RETENTION_DAYS="90"
SERVER_LOG_RETENTION_DAYS="90"
