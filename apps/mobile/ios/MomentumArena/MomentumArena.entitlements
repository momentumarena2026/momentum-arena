<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  APNs environment for the Push Notifications capability.

	  MUST be "production" for us. Our CI signs with MANUAL App Store
	  signing (see fastlane/Fastfile), so Xcode's automatic-signing flow
	  that would otherwise swap development→production for release archives
	  never runs — the value in this file is what ships. TestFlight and the
	  App Store both use the PRODUCTION APNs environment, so a build with
	  "development" here registers FCM tokens fine (getToken resolves) but
	  APNs silently drops every push. This file is shared by Debug + Release
	  configs; since every distributed build is a CI App Store archive,
	  "production" is correct. (Local on-device Debug push, if ever needed,
	  would want a per-config $(APS_ENVIRONMENT) split — not used today.)
	-->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
