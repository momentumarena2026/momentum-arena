<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  APNs environment for the Push Notifications capability.

	  MUST be "production" for us. Our CI signs with MANUAL App Store
	  signing (see fastlane/Fastfile), so Xcode's automatic-signing flow
	  that would otherwise swap development→production for release archives
	  never runs — the value in this file is what ships. TestFlight and the
	  App Store both use the PRODUCTION APNs environment, so a build with
	  "development" here registers FCM tokens fine (getToken resolves) but
	  APNs silently drops every push. This file is shared by Debug + Release
	  configs; since every distributed build is a CI App Store archive,
	  "production" is correct. (Local on-device Debug push, if ever needed,
	  would want a per-config $(APS_ENVIRONMENT) split — not used today.)
	-->
	<key>aps-environment</key>
	<string>production</string>
	<!--
	  Universal Links. iOS fetches
	  https://momentumarena.com/.well-known/apple-app-site-association on
	  install and, if this app's ID is listed there, hands matching
	  https://momentumarena.com/* taps to the app instead of Safari.

	  BOTH halves must agree or nothing happens: this entitlement, and
	  APPLE_TEAM_ID set in the web env so that file actually serves.
	  The www host is listed separately — Apple matches the exact host,
	  it does not follow the apex/www redirect.
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:momentumarena.com</string>
		<string>applinks:www.momentumarena.com</string>
	</array>
</dict>
</plist>
