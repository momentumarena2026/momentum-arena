<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ requires runtime permission for posting
         notifications. We request it lazily from JS (after first
         booking) via PermissionsAndroid. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Firebase Analytics auto-adds AD_ID, but we do no ads/attribution
         and the Play Console declaration says "no advertising ID" — Play
         rejects any AAB carrying the permission. Strip it from the merged
         manifest (Android analogue of the iOS
         $RNFirebaseAnalyticsWithoutAdIdSupport pod flag; adid collection
         itself is disabled in apps/mobile/firebase.json). -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <!-- expo-image-picker's OWN library manifest declares CAMERA. Play then
         implies <uses-feature android.hardware.camera required="true"> and
         drops every camera-less device — 427 of them (66 phones, 273 tablets)
         on the 1.0.6 bundle, versionCode 29803385. We only ever open the photo
         library (launchImageLibraryAsync), never the camera, so strip it from
         the merged manifest. app.json's "cameraPermission": false does NOT do
         this: config plugins only run under `expo prebuild`, and android/ is
         committed here, so CI goes straight to Gradle and the plugin is never
         executed. Same tools:node="remove" trick as AD_ID above. -->
    <uses-permission
        android:name="android.permission.CAMERA"
        tools:node="remove" />

    <!-- Android 11+ package-visibility: without this, Linking.canOpenURL()
         can't see other apps and UPI intent launches fail. Declare the UPI
         deep-link scheme so the OS resolves installed UPI apps. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" />
        </intent>
    </queries>

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <meta-data android:name="expo.modules.updates.ENABLED" android:value="true" />
      <meta-data android:name="expo.modules.updates.EXPO_UPDATE_URL" android:value="https://development.momentumarena.com/api/updates/manifest" />
      <meta-data android:name="expo.modules.updates.EXPO_RUNTIME_VERSION" android:value="@string/expo_runtime_version" />
      <meta-data android:name="expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH" android:value="ALWAYS" />
      <meta-data android:name="expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS" android:value="0" />
      <meta-data android:name="expo.modules.updates.UPDATES_CONFIGURATION_REQUEST_HEADERS_KEY" android:value="@string/expo_updates_request_headers" />
      <meta-data android:name="expo.modules.updates.CODE_SIGNING_CERTIFICATE" android:value="@string/expo_updates_code_signing_certificate" />
      <meta-data android:name="expo.modules.updates.CODE_SIGNING_METADATA" android:value="@string/expo_updates_code_signing_metadata" />
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!--
          App Links. autoVerify makes Android fetch
          https://momentumarena.com/.well-known/assetlinks.json at install
          and, if this package + signing fingerprint are listed, open
          momentumarena.com links in the app rather than Chrome.

          Needs ANDROID_SHA256_FINGERPRINTS set in the web env or
          verification fails and links keep going to the browser — silently,
          which is why it is worth checking with `adb shell pm get-app-links`
          after the next build.
        -->
        <intent-filter android:autoVerify="true">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" android:host="momentumarena.com" />
            <data android:scheme="https" android:host="www.momentumarena.com" />
        </intent-filter>
        <!--
          Custom scheme, kept in a SEPARATE filter on purpose: a
          non-https scheme inside an autoVerify block makes Android fail
          verification for every entry in that block.
        -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="momentumarena" />
        </intent-filter>
      </activity>
    </application>
</manifest>
